# Class: <http://purl.obolibrary.org/obo/FYPO_0001005> (fragmented DNA during nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:19366728") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001005> "A cell phenotype in which DNA is broken into small fragments when the cell is subject to nitrogen starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001005> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001005> "2012-04-25T04:01:19Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001005> "DNA fragmentation during nitrogen starvation")
