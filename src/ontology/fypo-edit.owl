# Class: <http://purl.obolibrary.org/obo/FYPO_0005069> (unequal mitotic sister chromatid segregation following normal mitosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:18180284") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005069> "A cellular process phenotype in which mitotic sister chromatid segregation fails to separate chromosomes into two equal masses after the cell has undergone a normal mitotic nuclear division and passed through the subsequent mitotic interphase. Unequal mitotic sister chromatid separation may be complete, with two distinct unequal DNA masses located at or near the ends of an elongated mitotic spindle, or incomplete.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005069> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005069> "2015-11-18T15:53:46Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005069> "mitotic chromosome nondisjunction following normal mitosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005069> "unequal mitotic chromosome segregation following normal mitosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005069> "unequal mitotic sister chromatid segregation during vegetative growth following normal mitosis")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005069> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005069> "unequal mitotic sister chromatid separation following normal mitosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005069> "unequal sister chromatid segregation following normal mitosis during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005069> "FYPO:0005069")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005069> "This phenotype affects the second round of mitosis to take place after a mutation exerts its effect. For example, if a conditional mutant is shifted to restrictive conditions in G1 or S phase and the first mitosis thereafter is normal, but the second is not (even if cells are returned to permissive conditions), this term is applicable.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005069> "unequal mitotic sister chromatid segregation following normal mitosis")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005069> <http://purl.obolibrary.org/obo/FYPO_0003241>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005069> <http://purl.obolibrary.org/obo/FYPO_0004588>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0005070> (obsolete cut with abolished mitotic sister chromatid separation, with mononucleate and anucleate compartment formation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005070> "OBSOLETE. An inviable phenotype observed in the vegetative growth phase of the life cycle in which a cell undergoes septation despite abolished mitotic sister chromatid separation, producing inviable daughter cells, and in which the septum forms in a position that partitions the nucleus into one compartment. Cell separation may or may not be completed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005070> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005070> "2015-11-18T16:08:59Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005070> "cut with abolished mitotic sister chromatid separation and anucleate cell formation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005070> "cut with abolished mitotic sister chromatid separation, with mononucleate and anucleate compartment formation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005070> "monoseptate vegetative cell with mononucleate and anucleate compartments following abolished mitotic sister chromatid separation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005070> "septation following abolished mitotic sister chromatid separation, with mononucleate and anucleate compartment formation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005070> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005070> "cut with abolished mitotic sister chromatid separation, with mononucleate and anucleate compartment formation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005070> "FYPO:0005070")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005070> "This term was made obsolete because its name and text definition were contradictory (the definition excludes the distinguishing features of \"cut\").")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005070> "obsolete cut with abolished mitotic sister chromatid separation, with mononucleate and anucleate compartment formation")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0005070> "true"^^xsd:boolean)

