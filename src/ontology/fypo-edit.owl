AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003120> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003120> "decreased transcription during glucose limitation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003120> "FYPO:0003120")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003120> "Use this term if there is evidence, such as labeled nucleotide incorporation, showing that transcription rather than RNA stability is affected; otherwise, use 'decreased RNA level' (FYPO:0000826). Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003120> "decreased transcription during glucose starvation")
