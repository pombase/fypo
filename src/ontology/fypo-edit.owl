# Class: <http://purl.obolibrary.org/obo/FYPO_0002062> (normal cell growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0016049") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002062> "A cellular process phenotype in which the growth of a cell is normal (i.e. indistinguishable from wild type). Cell growth is the process in which a cell irreversibly increases in size over time by accretion and biosynthetic production of matter similar to that already present.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002062> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002062> "2013-04-05T14:44:50Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002062> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002062> "FYPO:0002062")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002062> "Note that this term refers to growth at the level of any individual cell, and that it specifies only that increase in cell size due to metabolism is normal. Other aspects of the cell's biology may be abnormal, and other abnormalities may affect increase in cell number (population growth). Also see 'cell population growth phenotype' (FYPO:0000139) and its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002062> "normal cell growth")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0002062> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0016049>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000461>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002062> <http://purl.obolibrary.org/obo/FYPO_0000627>)

