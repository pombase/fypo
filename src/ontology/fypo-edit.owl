# Class: <http://purl.obolibrary.org/obo/FYPO_0001861> (increased minichromosome loss upon segregation during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001861> "A cell phenotype in which minichromosomes are lost due to abnormal mitotic sister chromatid segregation at a higher frequency than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001861> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001861> "2012-12-18T14:45:41Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001861> "increased plasmid loss upon segregation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001861> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001861> "mitotic minichromosome maintenance defect")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001861> "FYPO:0001861")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001861> "Use this term if the assay to detect minichromosome loss can distinguish a segregation defect from a replication defect (e.g. by microscopy). Note that in budding yeast, increased plasmid loss is often called a minichromosome maintenance defect, because \"minichromosome\" is roughly synonymous with an autonomously replicated and segregated plasmid in that organism. In fission yeast, a minichromosome is a large portion of a chromosome, usually about half of chromosome 3, that replicates and segregates autonomously. For smaller autonomously replicating and segregating constructs, consider 'increased plasmid loss' (FYPO:0000786).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001861> "increased minichromosome loss upon segregation during vegetative growth")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001861> <http://purl.obolibrary.org/obo/FYPO_0001840>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001861> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/fypo#output_of> <http://purl.obolibrary.org/obo/FYPO_0000141>))

