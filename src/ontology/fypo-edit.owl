AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002682> "FYPO:0002682")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002682> "increased resistance to chemical")
