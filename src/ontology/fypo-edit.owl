# Class: <http://purl.obolibrary.org/obo/FYPO_0006143> (obsolete delayed onset of protein tyrosine dephosphorylation during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006143> "OBSOLETE. A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the dephosphorylation of protein tyrosine residues begins later than normal. All protein tyrosine dephosphorylation may be affected, or tyrosine residues in one or more specific proteins, or at specific protein sites, or even specific sites within specific proteins.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0100001> <http://purl.obolibrary.org/obo/FYPO_0006143> "FYPO:0002830")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006143> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006143> "2017-07-24T14:13:49Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006143> "delayed onset of peptidyl-tyrosine dephosphorylation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006143> "delayed protein tyrosine dephosphorylation during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006143> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0035335") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006143> "delayed onset of protein tyrosine dephosphorylation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006143> "FYPO:0006143")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006143> "This term was made obsolete to implement a decision that protein modification terms should only include residue-specific information in cases where it is especially biologically significant, such as in histones or the RNA polymerase II CTD. In all other cases, phenotypic effects on specific modified residues should be captured in annotation extensions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006143> "obsolete delayed onset of protein tyrosine dephosphorylation during vegetative growth")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0006143> "true"^^xsd:boolean)

