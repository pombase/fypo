# Class: <http://purl.obolibrary.org/obo/FYPO_0000237> (abnormal regulation of translation in response to nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:18065650") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000237> "A gene expression phenotype in which regulation of translation in response to nitrogen starvation is abnormal. Translation may be down-regulated to a greater extent than normal, and may not be restored to normal levels upon prolonged nitrogen starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000237> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000237> "2011-04-19T02:59:38Z")
