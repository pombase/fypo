# Class: <http://purl.obolibrary.org/obo/FYPO_0006331> (decreased mating efficiency during stationary phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:25204792") Annotation(oboInOwl:hasDbXref "PMID:28160081") Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006331> "A biological process phenotype in which the observed mating efficiency, as determined by counting zygotes, asci, and sometimes spores, is lower than normal when the population in which the mating cells are found is in stationary phase.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006331> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006331> "2018-01-23T14:00:34Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006331> "reduced mating efficiency during stationary phase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006331> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006331> "FYPO:0006331")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006331> "Note that mating efficiency is often measured by counting zygotes plus asci, sometimes also including spores, so a change in measured mating efficiency may reflect a change in conjugation frequency (see FYPO:0000031 and its descendants), a change in sporulation (see FYPO:0000121 and its descendants), or both. For this reason, this term is not a child of 'mating phenotype' (FYPO:0000031).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006331> "decreased mating efficiency during stationary phase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0006331> <http://purl.obolibrary.org/obo/FYPO_0000708>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0006332> (normal mating efficiency during stationary phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:25204792") Annotation(oboInOwl:hasDbXref "PMID:28160081") Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006332> "A biological process phenotype in which the observed mating efficiency, as determined by counting zygotes, asci, and sometimes spores, is normal (i.e. the same as in wild-type cells) when the population in which the mating cells are found is in stationary phase.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006332> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006332> "2018-01-23T14:02:18Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006332> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006332> "FYPO:0006332")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006332> "Note that mating efficiency is often measured by counting zygotes plus asci, sometimes also including spores, so a change in measured mating efficiency may reflect a change in conjugation frequency (see FYPO:0000031 and its descendants), a change in sporulation (see FYPO:0000121 and its descendants), or both. For this reason, this term is not a child of 'mating phenotype' (FYPO:0000031).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006332> "normal mating efficiency during stationary phase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0006332> <http://purl.obolibrary.org/obo/FYPO_0001147>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0006333> (decreased zinc ion binding)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006333> "A molecular function phenotype in which occurrence of zinc ion binding by a gene product (usually a protein) in a mutant is decreased. The affected gene product may be encoded by the mutated gene, or by a different gene.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006333> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006333> "2018-01-23T14:03:57Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006333> "decreased zinc binding")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006333> "reduced zinc ion binding")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006333> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006333> "FYPO:0006333")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006333> "This term can mean that the mutated gene product itself binds zinc less than wild type, or that a mutation in one gene decreases zinc binding by a second gene product. When using this term, it is therefore recommended to note the specific protein(s) affected.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006333> "decreased zinc ion binding")
