# Class: <http://purl.obolibrary.org/obo/FYPO_0004837> (abolished cell population growth during glucose starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:25411338") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004837> "A vegetative cell population growth phenotype in which a cell population does not grow in a medium containing little or no glucose.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004837> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004837> "2015-08-18T14:03:57Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0004837> "abolished growth during glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004837> "abolished cell population growth during glucose depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004837> "abolished cell population growth during glucose deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004837> "abolished vegetative cell population growth during glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004837> "cell population growth during glucose starvation abolished")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004837> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004837> "abolished cell population growth during glucose limitation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004837> "FYPO:0004837")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004837> "Use this term for a population of cells that does not grow under conditions where glucose is absent or limiting (below about 4.4 mM (0.08%)), but does grow using a different carbon source or when more glucose is available (a cell population that does not grow on any media would be considered inviable). Note that cell growth terms refer to growth under aerobic conditions unless stated otherwise. Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004837> "abolished cell population growth during glucose starvation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004837> <http://purl.obolibrary.org/obo/FYPO_0001575>)

