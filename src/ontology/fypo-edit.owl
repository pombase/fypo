AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002958> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002958> "FYPO:0002958")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002958> "Encompasses both presence of proteins not normally found at the Mei2 nuclear dot and decreased levels or absence of proteins normally found there, and describes defects in a localization process. We recommend noting which protein(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002958> "abnormal protein localization to Mei2 nuclear dot")
