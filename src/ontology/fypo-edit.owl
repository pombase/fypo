SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002199> <http://purl.obolibrary.org/obo/FYPO_0001489>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002200> (inviable stubby septated vegetative cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002200> "A cell morphology phenotype in which a vegetatively growing cell is inviable and has one or more septa, and the cell diameter is larger than normal and the cell length is shorter than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002200> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002200> "2013-06-05T13:23:12Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002200> "inviable stubby septated cell during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002200> "inviable watermelon-shaped septated vegetative cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002200> "lethal; stubby septated vegetative cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002200> "stubby septated inviable vegetative cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002200> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002200> "inviable stubby septated vegetative cell during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002200> "FYPO:0002200")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002200> "Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'inviable cell population' (FYPO:0002059) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002200> "inviable stubby septated vegetative cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0002200> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000024>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001489>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0002342>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0072690>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002200> <http://purl.obolibrary.org/obo/FYPO_0000002>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002201> (obsolete viable stubby vegetative cell population)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002201> "OBSOLETE. A cell population phenotype in which all cells in the population are viable but the cell diameter is larger than normal and the cell length is shorter than normal, in the vegetative growth phase of the life cycle.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0100001> <http://purl.obolibrary.org/obo/FYPO_0002201> "FYPO:0002060")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002201> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002201> "2013-06-05T13:25:46Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002201> "stubby viable vegetative cell population")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002201> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002201> "FYPO:0002201")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002201> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype plus a full-penetrance extension.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002201> "obsolete viable stubby vegetative cell population")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002201> "true"^^xsd:boolean)

