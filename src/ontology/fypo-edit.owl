# Class: <http://purl.obolibrary.org/obo/FYPO_0003727> (galactose absent from cell wall glycoprotein glycan)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:11378902") Annotation(oboInOwl:hasDbXref "PMID:9125114") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003727> "A phenotype in which the glycan moiety of a glycoprotein in the cell wall does not contain galactose residues. In wild-type cells, glycoprotein glycans contain mannose and galactose residues in a 1:1.2 ratio, and the galactose residues are connected by alpha-1,2 linkages.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003727> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003727> "2014-08-27T10:38:02Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:9125114") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003727> "alpha 1,2-linked galactose residues absent from cell wall glycoprotein")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003727> "galactose absent from glycoprotein glycan in cell wall")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003727> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003727> "abolished galactosylation of cell surface proteins")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003727> "galactose absent from cell wall glycoprotein oligosaccharide")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003727> "FYPO:0003727")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003727> "Note that this term is not a child of 'galactose absent from cell wall' (FYPO:0002629) because the cell wall may contain galactose residues in glycans that are not part of glycosylated proteins.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003727> "galactose absent from cell wall glycoprotein glycan")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003727> <http://purl.obolibrary.org/obo/FYPO_0002628>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003727> <http://purl.obolibrary.org/obo/FYPO_0003291>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0003728> (abolished protein galactosylation during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0042125") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003728> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the galactosylation of one or more specific proteins, or of specific protein sites, does not occur. Protein galactosylation is the addition of a galactose residue to a protein amino acid.")
