# Class: <http://purl.obolibrary.org/obo/FYPO_0002941> (swollen spheroid cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002941> "A cell morphology phenotype in which a cell is shaped in the form of a spheroid, and has a larger volume than normal. In a swollen cell, both length and diameter may be greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal. In spheroid cells, there is much less difference between the long and short axes of the cell than in wild type. Spheroid cells may shorter than normal, with approximately the same diameter as normal, or they may be enlarged.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002941> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002941> "2013-12-04T13:30:22Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002941> "enlarged volume spheroid cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002941> "spheroid cell with increased cell volume")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002941> "swollen rounded cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002941> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002941> "enlarged spheroid cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002941> "large spheroid cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002941> "spheroid cell with increased cell size")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002941> "FYPO:0002941")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002941> "swollen spheroid cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0002941> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000025>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001955>))))
