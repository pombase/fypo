AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003241> "mitotic chromosome nondisjunction")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003241> "unequal mitotic chromosome segregation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003241> "unequal mitotic sister chromatid segregation during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003241> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003241> "unequal mitotic sister chromatid separation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003241> "unequal sister chromatid segregation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003241> "FYPO:0003241")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003241> "Consider also annotating to 'abnormal sister chromatid biorientation' (FYPO:0000326) because a problem with biorientation usually results in unequal chromosome segregation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003241> "unequal mitotic sister chromatid segregation")
