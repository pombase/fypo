AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000237> "abnormal translational regulation in response to nitrogen starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000237> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000237> "defective in recovery of translation during nitrogen starvation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000237> "FYPO:0000237")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000237> "This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000237> "abnormal regulation of translation in response to nitrogen starvation")
