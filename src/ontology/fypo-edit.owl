# Class: <http://purl.obolibrary.org/obo/FYPO_0005268> (abnormal mitotic cell cycle regulation during cellular response to methyl methanesulfonate)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005268> "A cellular response phenotype observed in the vegetative growth phase of the life cycle in which the regulation of the mitotic cell cycle in response to methyl methanesulfonate (MMS) is abnormal. Normally, cell cycle progression is slowed or arrested transiently following exposure to MMS. The most common abnormality is for the cell cycle to progress as in the absence of MMS.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005268> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005268> "2016-02-08T14:02:47Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005268> "abnormal cell cycle regulation during cellular response to methyl methanesulfonate")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005268> "abnormal cell cycle regulation during cellular response to methyl methanesulfonate during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005268> "abnormal mitotic cell cycle delay following methyl methanesulfonate exposure")
