AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007859> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007859> "nuclear division in absence of mitotic spindle during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007859> "rel syn DNA segregation in absence of mitotic spindle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007859> "FYPO:0007859")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007859> "nuclear division in absence of mitotic spindle")
