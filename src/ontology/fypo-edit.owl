AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005119> "altered protein-protein interaction specificity")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005119> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005119> "FYPO:0005119")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005119> "Also consider annotating to another term under 'abnormal protein binding', such as 'increased protein binding' (FYPO:0001571), to capture more details about the effect on protein binding specificity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005119> "altered protein binding specificity")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005119> <http://purl.obolibrary.org/obo/FYPO_0000704>)

