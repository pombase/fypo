AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002426> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002426> "obsolete inviable mixed population including divided and undivided germinated spores")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002426> "true"^^xsd:boolean)

