AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006754> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006754> "FYPO:0006754")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006754> "Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006754> "decreased promoter-enhancer looping during glucose starvation")
