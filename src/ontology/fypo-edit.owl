# Class: <http://purl.obolibrary.org/obo/FYPO_0002360> (normal chromatin silencing at centromere)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002360> "A transcription regulation phenotype observed in the vegetative growth phase of the life cycle in which chromatin silencing at centromeric regions is normal (i.e. indistinguishable from wild type). Chromatin silencing is the observed effect of processes that repress transcription in a region of the genome that is normally assembled into heterochromatin or CENP-A-containing chromatin (the latter is found at the centromere central core).")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002360> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002360> "2013-07-18T15:28:31Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002360> "normal chromatin silencing at centromere during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002360> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002360> "normal chromatin silencing at centromere during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002360> "FYPO:0002360")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002360> "Chromatin silencing phenotypes may reflect the assembly or maintenance of heterochromatin or CENP-A-containing chromatin. See the GO cellular component terms 'heterochromatin' (GO:0000792) and 'CENP-A containing chromatin' (GO:0061638), and the biological process terms 'heterochromatin organization' (GO:0070828) and 'CENP-A containing chromatin organization' (GO:0061641).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002360> "normal chromatin silencing at centromere")
