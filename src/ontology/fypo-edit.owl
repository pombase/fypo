AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002089> "abnormal exocytosis during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002089> "FYPO:0002089")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002089> "abnormal exocytosis during vegetative growth")
