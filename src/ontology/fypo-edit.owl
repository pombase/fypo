AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007968> "FYPO:0007968")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007968> "cut with mitotic spindle microtubules protruding beyond spindle pole body")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007968> <http://purl.obolibrary.org/obo/FYPO_0001055>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007968> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/fypo#output_of> <http://purl.obolibrary.org/obo/FYPO_0003787>))

