AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0004761> "increased histone exchange at dh repeat")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004761> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004761> "increased histone exchange at pericentric heterochromatin during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004761> "FYPO:0004761")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004761> "increased histone exchange at pericentric heterochromatin")
