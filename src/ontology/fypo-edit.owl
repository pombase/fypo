# Class: <http://purl.obolibrary.org/obo/FYPO_0002150> (inviable spore population)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002150> "A cell population phenotype in which none of the cells in a population of spores are viable. Inviable spores do not germinate.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002150> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002150> "2013-05-10T14:20:09Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002150> "inviable population of spores")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002150> "lethal in spore population")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002150> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002150> "essential in spore population")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002150> "FYPO:0002150")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002150> "Use this term only if no germination is observed in the entire population of mutant spores. An example of when this term is applicable is where a gene deletion in a diploid causes all null-mutant spores to fail to germinate, but the same gene deletion in vegetative cells is viable. To describe a mixed spore population in which some spores germinate and others do not, use the cell phenotype 'inviable spore' (FYPO:0002151; also consider related terms) with an extension to indicate penetrance.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002150> "inviable spore population")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002150> <http://purl.obolibrary.org/obo/FYPO_0002059>)

