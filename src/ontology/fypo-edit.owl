# Class: <http://purl.obolibrary.org/obo/FYPO_0000303> (decreased conjugation frequency)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000303> "A cell population phenotype in which a smaller than normal proportion of cells in the population undergoes conjugation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000303> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000303> "2011-04-26T02:40:00Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000303> "decreased mating frequency")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000303> "decreased occurrence of mating")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000303> "reduced conjugation frequency")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000303> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000303> "decreased conjugation efficiency")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000303> "reduced conjugation efficiency")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000303> "reduced zygote formation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000303> "FYPO:0000303")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000303> "Note that this term refers specifically to conjugation, whereas experiments that measure mating efficiency often do so by counting zygotes plus asci, sometimes also including spores. For such experiments, we recommend using 'decreased mating efficiency' (FYPO:0000708).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000303> "decreased conjugation frequency")
