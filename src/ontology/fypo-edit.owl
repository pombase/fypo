# Class: <http://purl.obolibrary.org/obo/FYPO_0001231> (normal cell cortex morphology)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0005938") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001231> "A physical cellular phenotype in which the size, shape, and structure of the cell cortex is normal (i.e. indistinguishable from wild type). The cell cortex is the region of a cell that lies just beneath the plasma membrane.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001231> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001231> "2012-07-16T13:54:21Z")
