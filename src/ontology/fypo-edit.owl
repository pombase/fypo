AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0070914") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0005428> "delayed onset of cyclobutane pyrimidine dimer repair")
