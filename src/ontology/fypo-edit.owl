# Class: <http://purl.obolibrary.org/obo/FYPO_0001229> (abnormal cell cortex morphology)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0005938") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001229> "A physical cellular phenotype in which the size, shape, or structure of all or part of the cell cortex is abnormal. The cell cortex is the region of a cell that lies just beneath the plasma membrane.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001229> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001229> "2012-07-16T13:51:27Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001229> "fission_yeast_phenotype")
