AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007919> "FYPO:0007919")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007919> "abnormal RNA alternative polyadenylation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007919> <http://purl.obolibrary.org/obo/FYPO_0001553>)

