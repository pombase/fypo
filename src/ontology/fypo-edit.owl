# Class: <http://purl.obolibrary.org/obo/FYPO_0006247> (premature mitotic G2/M phase transition during cellular response to osmotic stress)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000086") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006247> "A cell cycle phenotype in which the G2/M transition of the mitotic cell cycle begins earlier than normal during a cellular response to osmotic stress. The duration of G2 phase is thus shorter than normal. The mitotic G2/M transition is the point at which a cell commits to entering M phase, and begins when the kinase activity of M cyclin/CDK complex reaches a threshold high enough for the cell cycle to proceed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006247> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006247> "2017-10-17T14:13:09Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "advanced mitotic G2/M transition during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "mitotic G2/M transition advance during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "mitotic G2/M transition advance during cellular response to osmotic stress during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "mitotic cell cycle advance at G2/M transition during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "premature G2/M phase transition during cellular response to osmotic stress during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "premature cell cycle progression through mitotic G2/M phase transition during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "premature mitotic G2/M phase transition during cellular response to osmotic stress during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "premature mitotic G2/M transition during cellular response to osmotic stress")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006247> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "advanced mitotic G2 phase progression during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "cell cycle, mitotic G2 advance during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "decreased duration of mitotic G2 phase during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "decreased duration of mitotic G2 phase during cellular response to osmotic stress during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "decreased mitotic G2 duration during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "increased rate of mitotic G2 phase progression during cellular response to osmotic stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006247> "mitotic G2 advance during cellular response to osmotic stress")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006247> "FYPO:0006247")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006247> "Use this term if you have measured CDK activity or calculated the transition point to detect the transition; otherwise, consider using 'premature mitosis' (FYPO:0001046) or one of its descendants. A G2/M advance may indicate that a checkpoint, such as the DNA replication checkpoint or the G2/M DNA damage checkpoint, is impaired. Checkpoint activation can be tested using checkpoint kinase mutants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006247> "premature mitotic G2/M phase transition during cellular response to osmotic stress")
