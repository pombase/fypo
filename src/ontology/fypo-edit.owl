# Class: <http://purl.obolibrary.org/obo/FYPO_0003165> (cut with abnormal chromosome segregation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003165> "An inviable phenotype in which a cell undergoes mitotic catastrophe (i.e. enters mitosis prematurely and with defective chromosome segregation), and then septates to give rise to a cut phenotype. In a cut phenotype, a cell undergoes septation despite abnormal mitosis, such that the septum physically divides the nucleus into two parts, and produces inviable daughter cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003165> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003165> "2014-03-05T10:47:49Z")
AnnotationAssertion(oboInOwl:hasAlternativeId <http://purl.obolibrary.org/obo/FYPO_0003165> "FYPO:0001048")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003165> "cut with abnormal chromosome segregation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003165> "septation following abnormal chromosome segregation, with septum dividing nucleus")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003165> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003165> "cut with abnormal chromosome segregation during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003165> "cut with mitotic catastrophe")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003165> "mitotic catastrophe with cut")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003165> "FYPO:0003165")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003165> "Consider also annotating to 'septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation' (FYPO:0003166) or its descendants, because these phenotypes often co-occur.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003165> "cut with abnormal chromosome segregation")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0003165> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000141>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001204>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001489>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000001> <http://purl.obolibrary.org/obo/GO_0072690>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003165> <http://purl.obolibrary.org/obo/FYPO_0000002>)
