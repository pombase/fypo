AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "SPB detached from cytoplasmic microtubules")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "abolished microtubule attachment to spindle pole body during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "cytoplasmic microtubules absent from mitotic spindle pole body")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "cytoplasmic microtubules detached from spindle pole body")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "interphase microtubules detached from nucleus")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Pombase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "interphase microtubules detached from spindle pole body")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "spindle pole body detached from cytoplasmic microtubules")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004613> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004613> "abolished microtubule attachment to spindle pole body during mitotic cell cycle")
