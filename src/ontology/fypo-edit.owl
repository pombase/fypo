# Class: <http://purl.obolibrary.org/obo/FYPO_0002453> (obsolete inviable microcolony, septated cells with abnormal morphology)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002453> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells that have abnormal morphology (i.e. size, shape, or structure) and contain one or more septa apiece. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002453> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002453> "2013-08-06T14:44:38Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002453> "inviable microcolony, septated vegetative cells with abnormal morphology")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002453> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002453> "FYPO:0002453")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002453> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002453> "obsolete inviable microcolony, septated cells with abnormal morphology")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002453> "true"^^xsd:boolean)

