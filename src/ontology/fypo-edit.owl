# Class: <http://purl.obolibrary.org/obo/FYPO_0002303> (inviable mononucleate monoseptate vegetative cell with anucleate compartment)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002303> "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which a cell is inviable, and has one nucleus and one septum. The septum divides the cell into two compartments, one of which contains the nucleus.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002303> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002303> "2013-06-20T13:59:28Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable mononucleate monoseptate cell during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable mononucleate monoseptate vegetative cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "lethal; mononucleate monoseptate vegetative cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002303> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:7798319") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "displaced nucleus with septum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable mononucleate monoseptate vegetative cell during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable with septation in the absence of nuclear division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable with septation independent of mitosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable with septation without nuclear division")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002303> "FYPO:0002303")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002303> "In cells with this phenotype, septation has proceeded despite chromosome segregation failing to complete normally. Chromosome segregation may be incomplete or entirely abolished. Consider also annotating to 'cut' (FYPO:0003155), 'septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation' (FYPO:0003166), or their descendants, because these phenotypes often co-occur.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002303> "inviable mononucleate monoseptate vegetative cell with anucleate compartment")
