# Class: <http://purl.obolibrary.org/obo/FYPO_0000996> (tapered cell during nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:19366728") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000996> "A cell morphology phenotype in which the cell tapers at one end to a diameter smaller than the other when the cell is subject to nitrogen starvation. The cell diameter at the narrow end is smaller than that of a wild-type cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000996> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000996> "2012-04-25T02:41:14Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000996> "bottle-shaped cell during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000996> "cell morphology, bottle/skittle during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000996> "skittle-shaped cell during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000996> "tapered cell during nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000996> "tapered cell during nitrogen deprivation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000996> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000996> "FYPO:0000996")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000996> "This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. Note that the difference between 'tapered cell' (FYPO:0000014) and 'spindle-shaped cell' (FYPO:0007230) is that a tapered cell is narrow at only one end, whereas a spindle-shaped cell is narrow at both ends.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000996> "tapered cell during nitrogen starvation")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0000996> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0002213> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0006995>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0000521>))))
