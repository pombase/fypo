# Class: <http://purl.obolibrary.org/obo/FYPO_0005394> (progressively decreasing vegetative cell population growth rate followed by return to normal growth rate)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:12196391") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005394> "A cell population phenotype in which vegetative cell population growth is slower than normal for several generations, with the population growth rate decreasing over successive generations, after which the population resumes growing at a normal or near-normal rate.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005394> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005394> "2016-05-03T14:48:15Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005394> "progressively decreasing cell population growth rate followed by return to normal growth rate during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005394> "progressively reduced vegetative cell population growth rate followed by return to normal growth rate")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005394> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005394> "emergence of telomerase-deficient survivors")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005394> "progressively decreasing cell population proliferation followed by return to normal proliferation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005394> "progressively decreasing cell proliferation followed by return to normal proliferation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005394> "progressively reduced cell proliferation followed by return to normal proliferation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005394> "FYPO:0005394")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005394> "This population growth pattern is often seen with mutations that affect telomere maintenance. The slowing growth reflects a high rate of cell death as telomeres shorten, and in a small sub-population of cells, chromosomes circularize allowing the population to resume growth at a higher, often normal, rate.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005394> "progressively decreasing vegetative cell population growth rate followed by return to normal growth rate")
