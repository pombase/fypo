# Class: <http://purl.obolibrary.org/obo/FYPO_0007379> (T-shaped vegetative cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007379> "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which a new growth zone forms along the lateral portion of the cell (often in the middle) before septation, such that a single cell grows in the form of the letter T.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007379> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007379> "2020-05-27T11:17:42Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007379> "T-shaped cell during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007379> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007379> "T-shaped vegetative cell during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007379> "FYPO:0007379")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007379> "One distinction between T-shaped and other branched cells is that in T-shaped cells the new growth zone forms before NETO. A T-shaped cell may septate perpendicular to the normal septation axis, and divide to form normal-shaped daughter cells. Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'viable cell population' (FYPO:0002058) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007379> "T-shaped vegetative cell")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007379> <http://purl.obolibrary.org/obo/FYPO_0000015>)
