AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002003> "abolished transcription factor binding to promoter region")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002003> "FYPO:0002003")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002003> "abolished RNA polymerase II proximal promoter sequence-specific DNA binding")
