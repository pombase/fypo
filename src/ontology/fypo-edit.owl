# Class: <http://purl.obolibrary.org/obo/FYPO_0002192> (obsolete inviable microcolony, normal volume septated spheroid cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002192> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells that have a normal volume and spheroid shape, and contain one or more septa each. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002192> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002192> "2013-06-04T17:27:04Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002192> "inviable microcolony, normal volume septated rounded cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002192> "inviable microcolony, normal volume septated spheroid vegetative cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002192> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002192> "FYPO:0002192")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002192> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002192> "obsolete inviable microcolony, normal volume septated spheroid cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002192> "true"^^xsd:boolean)

