AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001860> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001860> "2012-12-18T14:43:49Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001860> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001860> "increased minichromosome loss during meiosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001860> "meiotic minichromosome maintenance defect")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001860> "FYPO:0001860")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001860> "increased minichromosome loss during meiotic cell cycle")
