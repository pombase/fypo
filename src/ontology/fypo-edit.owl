AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0003937> "increased aerobic cell population growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003937> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003937> "FYPO:0003937")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003937> "increased cell population growth")
