AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006692> "cut with septum between unequally sized nuclei during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006692> "FYPO:0006692")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006692> "In cells with this phenotype, septation has proceeded despite chromosome segregation failing to complete normally. Chromosome separation is entirely abolished. Consider also annotating to 'cut' (FYPO:0003155) or its descendants, because these phenotypes often co-occur.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006692> "cut with septum between unequally sized nuclei")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0006692> <http://purl.obolibrary.org/obo/FYPO_0000229>)

