AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003825> "inviable cell with mitotic G2/M arrest after failed cytokinesis")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003825> "FYPO:0003825")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003825> "This phenotype may indicate that the cytokinesis after mitosis checkpoint is activated. Use this term when a cell goes through a cell cycle without cytokinesis taking place. In the subsequent cell cycle, the two nuclei can go through G1 and S phases but cannot undergo mitosis, so the nuclei remain in G2 phase. The cell does not contain a post-anaphase microtubule array.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003825> "inviable binucleate aseptate cell with cell cycle arrest at mitotic G2/M phase transition before cell separation")
