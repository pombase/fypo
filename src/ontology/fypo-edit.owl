# Class: <http://purl.obolibrary.org/obo/FYPO_0004177> (increased RNA level during nitrogen starvation in h- cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:8668157") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004177> "A cell phenotype in which the amount of RNA measured in a cell of the h- mating type when the cell is subject to nitrogen starvation is higher than normal. Total RNA or a specific RNA may be affected.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004177> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004177> "2014-12-16T15:28:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004177> "increased RNA level during nitrogen depletion in h- cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004177> "increased RNA level during nitrogen deprivation in h- cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004177> "increased transcript level during nitrogen starvation in h- cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004177> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004177> "increased RNA accumulation during nitrogen starvation in h- cells")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004177> "FYPO:0004177")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004177> "Consider annotating to a term describing abnormal transcription or abnormal regulation of transcription, but note that changes in RNA levels may result from changes in RNA stability as well as changes in transcription. This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. We recommend noting which RNA(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004177> "increased RNA level during nitrogen starvation in h- cells")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0004177> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001162> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0006995>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0002674>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002503> <http://purl.obolibrary.org/obo/CHEBI_33697>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004177> <http://purl.obolibrary.org/obo/FYPO_0002020>)

