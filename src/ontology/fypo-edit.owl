# Class: <http://purl.obolibrary.org/obo/FYPO_0000779> (inviable elongated vegetative cell with central constriction)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000779> "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which a cell is inviable, is longer than normal and has an abnormal shape featuring a constriction at the center of the cell, corresponding to the cell division site. In some such cells, the diameter at the ends is much greater than in wild-type cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000779> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000779> "2012-02-13T12:48:01Z")
AnnotationAssertion(oboInOwl:hasAlternativeId <http://purl.obolibrary.org/obo/FYPO_0000779> "FYPO:0000018")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "inviable elongated cell with central constriction during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "inviable elongated swollen vegetative cell with constricted region at cell division site")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "lethal; elongated vegetative cell with central constriction")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000779> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "cell morphology, elongated dumbbell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "cell morphology, long dumbbell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "elongated dumbbell morphology")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "inviable elongated cell with central constriction during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000779> "inviable elongated dumbbell-shaped vegetative cell")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000779> "FYPO:0000779")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000779> "Note that cell with this phenotype, often called dumbbell-shaped, are usually also elongated. The distinction between this phenotype and swollen elongated cells (FYPO:0001429) is that dumbbell-shaped cells have a constriction along the long axis, whereas swollen elongated cells do not. Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'inviable cell population' (FYPO:0002059) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000779> "inviable elongated vegetative cell with central constriction")
