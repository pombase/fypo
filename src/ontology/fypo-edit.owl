# Class: <http://purl.obolibrary.org/obo/FYPO_0004592> (cut following normal mitosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004592> "An inviable phenotype observed in the vegetative growth phase of the life cycle in which a cell becomes cut after it has undergone a normal mitotic nuclear division and passed through the subsequent mitotic interphase. In a cut phenotype, a cell undergoes septation despite abnormal chromosome segregation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004592> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004592> "2015-04-29T15:56:48Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004592> "cut following normal mitosis and interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004592> "cut following normal mitosis and passage through mitotic G1 phase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004592> "cut following normal mitosis during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0140014") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004592> "cut following normal mitotic nuclear division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004592> "cut following normal nuclear division during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004592> "septation following abnormal mitotic chromosome segregation with normal mitosis")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004592> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004592> "FYPO:0004592")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004592> "This phenotype affects the second round of mitosis to take place after a mutation exerts its effect. For example, if a conditional mutant is shifted to restrictive conditions in G1 or S phase and the first mitosis thereafter is normal, but the second results in a cut cell (even if cells are returned to permissive conditions), this term is applicable.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004592> "cut following normal mitosis")
