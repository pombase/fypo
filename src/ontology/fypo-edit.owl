# Class: <http://purl.obolibrary.org/obo/FYPO_0000299> (obsolete inviable microcolony)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000299> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000299> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000299> "2011-04-26T02:13:39Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0000299> "microcolony formation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000299> "inviable microcolony formation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000299> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000299> "FYPO:0000299")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000299> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000299> "obsolete inviable microcolony")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0000299> "true"^^xsd:boolean)

