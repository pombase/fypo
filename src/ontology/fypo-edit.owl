# Class: <http://purl.obolibrary.org/obo/FYPO_0000278> (decreased cell population growth following spore germination)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000278> "A cell population phenotype in which cell population growth is decreased following spore germination, resulting in the formation of a smaller colony than normal in a given amount of time.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000278> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000278> "2011-04-19T04:37:01Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0000278> "decreased growth following spore germination")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000278> "reduced cell population growth following spore germination")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0000278> "slow cell population growth following spore germination")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000278> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000278> "spores produced smaller colonies")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000278> "FYPO:0000278")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000278> "Note that cell growth terms refer to growth under aerobic conditions unless stated otherwise.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000278> "decreased cell population growth following spore germination")
