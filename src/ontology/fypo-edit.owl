AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001430> "2012-08-22T15:27:17Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001430> "abnormal mitotic cell cycle arrest with 1C DNA content")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001430> "abnormal mitotic cell cycle arrest with unreplicated DNA during vegetative growth")
