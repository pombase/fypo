# Class: <http://purl.obolibrary.org/obo/FYPO_0002090> (lagging chromosomes)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002090> "A cellular process phenotype in which homologous chromosomes or sister chromatids do not move towards the spindle poles at the same time during nuclear division, but instead one or more chromosomes remain distant from the spindle pole after the bulk of the DNA has separated. Segregation may stop before completing separation of chromosomes, or may eventually be completed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002090> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002090> "2013-05-01T16:58:26Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002090> "chromosome segregation defects, lagging chromosomes")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002090> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002090> "FYPO:0002090")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002090> "Chromosome lagging may reflect a delay in detachment of homologous chromosomes or sister chromatids from each other ('chromosome separation' as defined by GO:0051304), polewards movement (GO:0051305), or both.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002090> "lagging chromosomes")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002090> <http://purl.obolibrary.org/obo/FYPO_0000029>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002091> (lagging meiotic chromosomes)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002091> "A cellular process phenotype in which homologous chromosomes or sister chromatids do not move towards the spindle poles at the same time during meiosis I or meiosis II, but instead one or more chromosomes remain distant from the spindle pole after the bulk of the DNA has separated. Segregation may stop before completing separation of chromosomes, or may eventually be completed.")
