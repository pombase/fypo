# Class: <http://purl.obolibrary.org/obo/FYPO_0000339> (mislocalized septum during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000339> "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which a cell has a septum in an abnormal location. The normal location is at the midpoint of the long axis of the cell. The site of septum assembly is normally determined by the location of the actomyosin contractile ring.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000339> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000339> "2011-06-13T02:57:21Z")
AnnotationAssertion(oboInOwl:hasAlternativeId <http://purl.obolibrary.org/obo/FYPO_0000339> "FYPO:0002154")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum location during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum position during vegetative growth")
AnnotationAssertion(oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum postitioning")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "asymmetric septum during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "asymmetrically located septum during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "mislocalised septum during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "misplaced septum during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000339> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal contractile ring localization resulting in abnormal septum site selection")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal contractile ring localization resulting in mislocalized septum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal division septum site selection")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum localization during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum positioning during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum site selection")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum site selection during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "abnormal septum site selection during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "mislocalized septum during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000339> "septum site selection defects")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000339> "FYPO:0000339")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000339> "Note that the location of the septum is determined by the location of the contractile ring, which in turn is determined by the location of the cell division site, so an abnormality in cell division site determination can be inferred from this phenotype. Consider also annotating to 'mislocalized actomyosin contractile ring' (FYPO:0001369) because if the contractile ring forms in an abnormal location, the septum will also do so.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000339> "mislocalized septum during vegetative growth")
