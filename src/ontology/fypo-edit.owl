# Class: <http://purl.obolibrary.org/obo/FYPO_0005641> (abnormal chromosome segregation during meiosis I with premature sister kinetochore separation, lagging chromosomes, and normal chromosome separation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21920317") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005641> "A cellular process phenotype in which kinetochores become separated during the first meiotic nuclear division, and in which homologous chromosomes do not move towards the spindle poles at the same time during anaphase, but are eventually separated normally.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005641> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005641> "2016-08-26T14:07:01Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005641> "abnormal chromosome segregation during first meiotic nuclear division with premature sister kinetochore separation, lagging chromosomes, and normal chromosome separation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005641> "abnormal chromosome segregation during meiosis I with precocious centromeric dissociation, lagging chromosomes, and normal chromosome separation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005641> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005641> "abnormal chromosome segregation during meiosis I with premature sister kinetochore separation, lagging chromosomes, and normal chromosome segregation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005641> "abnormal chromosome segregation during meiosis I with split kinetochores, lagging chromosomes, and normal chromosome separation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005641> "FYPO:0005641")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005641> "This term describes the premature separation of paired, intact sister kinetochores. It has a related synonym using \"split kinetochores\" because that phrase is often used in the literature to describe this phenotype. It should not be confused with the FYPO terms that have \"split kinetochore\" in the names, because those names refer to cases where a single kinetochore has broken into parts.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005641> "abnormal chromosome segregation during meiosis I with premature sister kinetochore separation, lagging chromosomes, and normal chromosome separation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005641> <http://purl.obolibrary.org/obo/FYPO_0005633>)
