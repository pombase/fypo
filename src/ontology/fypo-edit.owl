AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007435> "inviable elongated mononucleate cell during nitrogen deprivation")
