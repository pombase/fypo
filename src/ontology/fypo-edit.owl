AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004801> "delayed premeiotic DNA replication during azygotic meiotic cell cycle")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004801> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004801> "delayed onset of premeiotic DNA replication during azygotic meiosis")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004801> "FYPO:0004801")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004801> "delayed onset of premeiotic DNA replication during azygotic meiosis")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004801> <http://purl.obolibrary.org/obo/FYPO_0004628>)

