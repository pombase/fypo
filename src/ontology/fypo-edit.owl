AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000781") Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002155> "normal chromosome structure at telomeric region during vegetative growth")
