# Class: <http://purl.obolibrary.org/obo/FYPO_0000017> (elongated cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000017> "A cell morphology phenotype in which cells are longer than normal, and the length:diameter ratio is greater than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000017> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000017> "2011-03-29T05:53:56Z")
