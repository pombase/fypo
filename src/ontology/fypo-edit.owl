# Class: <http://purl.obolibrary.org/obo/FYPO_0002484> (increased intergenic meiotic recombination)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:11726502") Annotation(oboInOwl:hasDbXref "PMID:22723423") Annotation(oboInOwl:hasDbXref "PomBase:gs") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002484> "A cellular process phenotype in which the occurrence of two meiotic reciprocal recombination events (crossovers) close to each other is incresed. As a result, the resolution of meiotic recombination intermediates results in the formation of a crossover at a higher frequency than normal, and the occurrence of intergenic meiotic recombination is increased.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002484> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002484> "2013-08-08T14:57:12Z")
AnnotationAssertion(oboInOwl:hasAlternativeId <http://purl.obolibrary.org/obo/FYPO_0002484> "FYPO:0005374")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:16169489") Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002484> "increased meiotic intergenic recombination")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002484> "increased resolution of meiotic recombination intermediates with crossover formation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002484> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22723423") Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002484> "increased occurrence of meiotic cross-overs")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002484> "FYPO:0002484")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002484> "increased intergenic meiotic recombination")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002484> <http://purl.obolibrary.org/obo/FYPO_0000487>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002485> (decreased intergenic meiotic recombination)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:16169489") Annotation(oboInOwl:hasDbXref "PMID:22723423") Annotation(oboInOwl:hasDbXref "PomBase:gs") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002485> "A cellular process phenotype in which the occurrence of two meiotic reciprocal recombination events (crossovers) close to each other is decresed. As a result, the resolution of meiotic recombination intermediates results in the formation of a crossover at a lower frequency than normal, and the occurrence of intergenic meiotic recombination is decreased.")
