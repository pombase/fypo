# Class: <http://purl.obolibrary.org/obo/FYPO_0002796> (abnormal protein degradation during nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0030163") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002796> "A cellular process phenotype in which protein degradation is abnormal when the cell is subject to nitrogen starvation. Protein degradation, also known as protein catabolism, is any metabolic process that results in the destruction of the native, active configuration of a protein, with or without the hydrolysis of peptide bonds.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002796> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002796> "2013-10-16T16:11:43Z")
