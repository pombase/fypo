AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006195> "decreased number of elongated microtubule bundles curved around end of cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0006195> "single elongated microtubule bundle curved around cell end")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006195> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006195> "decreased number of elongated microtubule bundles curved around cell end during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006195> "decreased number of microtubule arrays curved around cell end")
