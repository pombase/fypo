# Class: <http://purl.obolibrary.org/obo/FYPO_0003473> (septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation during cellular response to salt stress)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003473> "An inviable phenotype observed in the vegetative growth phase of the life cycle in which a cell undergoes septation despite abnormal chromosome segregation, producing inviable daughter cells, and in which the septum forms in a position that partitions both nuclei into one compartment, when the cell is subject to salt stress. Cell separation may or may not be completed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003473> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003473> "2014-06-24T15:05:37Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003473> "septation following abnormal chromosome segregation, with anucleate cell formation during cellular response to salt stress during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003473> "septation following abnormal chromosome segregation, with binucleate cell formation during cellular response to salt stress")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003473> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003473> "septation following abnormal chromosome segregation, with anucleate cell formation during cellular response to salt stress during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003473> "FYPO:0003473")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003473> "In cells with this phenotype, septation has proceeded despite chromosome segregation failing to complete normally. Chromosome segregation may be incomplete or entirely abolished. Consider also annotating to 'cut' (FYPO:0003155) or its descendants, because these phenotypes often co-occur.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003473> "septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation during cellular response to salt stress")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003473> <http://purl.obolibrary.org/obo/FYPO_0003166>)

