AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000156> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000156> "abnormal chromatin silencing at silent mating-type cassette during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000156> "FYPO:0000156")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000156> "Chromatin silencing phenotypes may reflect the assembly or maintenance of heterochromatin. See the GO cellular component term 'heterochromatin' (GO:0000792), and the biological process term 'heterochromatin organization' (GO:0070828).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000156> "abnormal chromatin silencing at silent mating-type cassette")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0000156> <http://purl.obolibrary.org/obo/FYPO_0000144>)

