AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004720> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004720> "FYPO:0004720")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004720> "normal viability following cellular response to heat shock")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004720> <http://purl.obolibrary.org/obo/FYPO_0000257>)
