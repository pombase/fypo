# Class: <http://purl.obolibrary.org/obo/FYPO_0000013> (T-shaped vegetative cell with normal cell length)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000013> "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which cell length is normal, and a new growth zone forms along the lateral portion of the cell (often in the middle) before septation, such that a single cell grows in the form of the letter T.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000013> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000013> "2011-03-29T05:53:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000013> "T-shaped cell with normal cell length during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000013> "cell morphology, T shaped with normal cell length during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000013> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000013> "T-shaped vegetative cell with normal cell length during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000013> "FYPO:0000013")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000013> "One distinction between T-shaped and other branched cells is that in T-shaped cells the new growth zone forms before NETO. A T-shaped cell may septate perpendicular to the normal septation axis, and divide to form normal-shaped daughter cells. Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'viable cell population' (FYPO:0002058) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000013> "T-shaped vegetative cell with normal cell length")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0000013> <http://purl.obolibrary.org/obo/FYPO_0000015>)
