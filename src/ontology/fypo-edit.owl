AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002469> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002469> "obsolete inviable microcolony, elongated tapered cells")
