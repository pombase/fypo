EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0004718> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0097355>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004718> <http://purl.obolibrary.org/obo/FYPO_0001370>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004719> (abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:8387358") Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004719> "A cellular process phenotype in which progression through the mitotic cell cycle is arrested when cells have condensed chromosomes and a single, normally located septum, under conditions where arrest does not normally occur.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004719> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004719> "2015-07-20T16:00:02Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004719> "abnormal cell cycle arrest with condensed chromosomes, septated cell during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004719> "abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004719> "abnormal mitotic cell cycle arrest with condensed chromosomes, septated vegetative cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004719> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004719> "FYPO:0004719")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004719> "In wild-type cells, chromosomes are condensed only in M phase. This term can be used for mutants in which chromosomes are condensed but other normal features of M phase cells are not observed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004719> "abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004719> <http://purl.obolibrary.org/obo/FYPO_0003738>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004720> (normal viability following cellular response to heat shock)

