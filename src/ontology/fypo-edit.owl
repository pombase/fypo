AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002207> "FYPO:0002207")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002207> "inviable swollen spore")
