# Class: <http://purl.obolibrary.org/obo/FYPO_0002844> (obsolete inviable microcolony, swollen elongated septated cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002844> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells which are septated, elongated, and have a larger than normal cell volume. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002844> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002844> "2013-11-05T16:02:59Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002844> "inviable microcolony, swollen elongated septated vegetative cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002844> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002844> "inviable microcolony, enlarged long septated vegetative cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002844> "inviable microcolony, large elongated septated vegetative cells")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002844> "FYPO:0002844")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002844> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002844> "obsolete inviable microcolony, swollen elongated septated cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002844> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002845> (inviable swollen elongated septated vegetative cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002845> "A cell morphology phenotype in which a vegetative cell is inviable, is swollen, is elongated, and contains one or more septa. In a swollen cell, both length and diameter may be greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002845> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002845> "2013-11-05T16:06:04Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002845> "lethal; swollen elongated septated vegetative cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002845> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002845> "inviable enlarged elongated septated vegetative cell with enlarged nucleus")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002845> "inviable large elongated septated vegetative cell")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002845> "FYPO:0002845")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002845> "The distinction between this phenotype and centrally constricted (dumbbell-shaped) cells (FYPO:0000779) is that swollen elongated cells do not have a constriction along the long axis. Swollen elongated cells may have a uniform diameter, or may be swollen only around the nucleus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002845> "inviable swollen elongated septated vegetative cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0002845> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000646>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001122>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001489>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0002342>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0072690>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002845> <http://purl.obolibrary.org/obo/FYPO_0000002>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002846> (obsolete inviable mixed population including spores, germinated spores and small cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002846> "OBSOLETE. A mixed population phenotype in which all cells in a population are inviable, and the population includes a mixture of ungerminated spores, germinated spores and small vegetative cells. The spheroid cells arise from division of some of the germinated spores, and may form a microcolony of up to 64 cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002846> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002846> "2013-11-05T16:59:57Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002846> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002846> "FYPO:0002846")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002846> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002846> "obsolete inviable mixed population including spores, germinated spores and small cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002846> "true"^^xsd:boolean)

