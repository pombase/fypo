AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001229> "Note that an abnormal cell cortex organization process may, but does not necessarily, result in abnormal cell cortex morphology.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001229> "abnormal cell cortex morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0001229> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0005938>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
