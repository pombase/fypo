# Class: <http://purl.obolibrary.org/obo/FYPO_0005642> (abnormal meiotic homologous chromosome biorientation with abnormal kinetochore orientation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21920317") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005642> "A cellular process phenotype in which homologous chromosome biorientation is abnormal during meiosis, with chromosomes that are not correctly oriented with the kinetochores facing outwards. Homologous chromosome biorientation is the process in which the sister centromeres of one chromosome attach to microtubules that emanate from the same spindle pole, ensuring that homologous maternal and paternal chromosomes are pulled in opposite directions at anaphase of meiosis I.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005642> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005642> "2016-08-26T14:19:36Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005642> "abnormal homologous chromosome biorientation with abnormal kinetochore orientation during meiosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0031619") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005642> "abnormal homologous chromosome orientation involved in meiotic metaphase I plate congression with abnormal kinetochore orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005642> "abnormal meiotic homologous chromosome biorientation with abnormal kinetochore position")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005642> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005642> "FYPO:0005642")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005642> "abnormal meiotic homologous chromosome biorientation with abnormal kinetochore orientation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005642> <http://purl.obolibrary.org/obo/FYPO_0003177>)

