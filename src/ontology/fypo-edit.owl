AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003623> "normal protein threonine phosphorylation during cellular response to heat during vegetative growth")
