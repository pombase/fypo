# Class: <http://purl.obolibrary.org/obo/FYPO_0001122> (elongated vegetative cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001122> "A cell phenotype in which a cell is longer, and has a greater length:diameter ratio, than normal in the vegetative growth phase of the life cycle.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001122> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001122> "2012-06-07T13:10:57Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001122> "long vegetative cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001122> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001122> "FYPO:0001122")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001122> "Note that this term is classified as a type of abnormal cell shape, because wild-type cells are never seen with the proportions (length:diameter ratio) observed in elongated cells. Small cells, in contrast, have the same proportions as a subset of wild-type cells, and simply do not grow to the full length seen in wild type.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001122> "elongated vegetative cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0001122> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000017> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0000334>))))
