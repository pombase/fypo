# Class: <http://purl.obolibrary.org/obo/FYPO_0004366> (syntelic kinetochore attachment during mitosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:17426725") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004366> "A cellular process phenotype in which the attachment of spindle microtubules to the kinetochore during a mitotic nuclear division results in the connection of both sister kinetochores to microtubules from the same spindle pole.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004366> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004366> "2015-02-10T12:37:25Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004366> "syntelic attachment of spindle microtubules to kinetochore during mitosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0140014") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004366> "syntelic kinetochore attachment during mitotic nuclear division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004366> "syntelic kinetochore attachment during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004366> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004366> "syntelic kinetochore attachment during mitotic M phase")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004366> "FYPO:0004366")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004366> "Syntelic attachment activates the spindle assembly checkpoint, presumably due to lack of tension between the sister chromatids. If uncorrected, syntelic attachment will result in segregation of both sister chromatids to the same daughter cell, generating aneuploidy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004366> "syntelic kinetochore attachment during mitosis")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004366> <http://purl.obolibrary.org/obo/FYPO_0004213>)

