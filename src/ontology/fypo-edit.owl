AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007458> "abolished nuclear pore localization to mitotic nuclear bridge during vegetative growth")
