AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0009056> "decreased kinetochore microtubule depolymerization during mitotic anaphase A"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0009056> <http://purl.obolibrary.org/obo/FYPO_0005423>)

