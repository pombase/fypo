AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007392> "increased haploidisation in presence of chromosome 3 disomy")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007392> "increased loss of disomic chromosome 3 during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007392> "FYPO:0007392")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007392> "This phenotype results from increased chromosome instability in aneuploid cells, restores the cells to euhaploid, and causes haploid colonies to arise at a higher frequency.")
