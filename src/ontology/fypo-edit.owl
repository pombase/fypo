# Class: <http://purl.obolibrary.org/obo/FYPO_0000786> (increased plasmid loss)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000786> "A cell phenotype observed in the vegetative growth phase of the life cycle in which plasmids are lost at a higher frequency than normal. Plasmid loss occurs when one or both daughter cells do not inherit copies of a plasmid from the mother cell, and may result from failure of plasmid replication or segregation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000786> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000786> "2012-02-29T01:39:20Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000786> "increased plasmid loss during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000786> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000786> "increased plasmid loss during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000786> "FYPO:0000786")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000786> "Note that in budding yeast, increased plasmid loss is often called a minichromosome maintenance defect, because \"minichromosome\" is roughly synonymous with an autonomously replicated and segregated plasmid in that organism.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000786> "increased plasmid loss")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0000786> <http://purl.obolibrary.org/obo/FYPO_0003755>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0000787> (abnormal histone H3-K9 trimethylation during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000787> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which trimethylation of lysine at position 9 of histone H3 is abnormal.")
