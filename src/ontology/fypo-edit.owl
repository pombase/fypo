AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006211> "inviable germinated spore, without germ tube formation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006211> "lethal after spore germination, before germ tube formation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006211> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006211> "FYPO:0006211")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006211> "Spores with this phenotype can be identified by loss of spore refractility that can be observed by light microscopy or by a decrease in optical absorbance of the spore suspension.")
