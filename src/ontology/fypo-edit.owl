# Class: <http://purl.obolibrary.org/obo/FYPO_0005943> (decreased break-induced loss of heterozygosity via chromosomal translocation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:19798055") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005943> "A cell phenotype observed in the vegetative growth phase of the life cycle in which chromosomal translocation that would result in the loss of one of two different alleles of a gene occurs to a lower extent than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005943> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005943> "2017-03-09T15:01:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005943> "decreased break-induced loss of heterozygosity via chromosomal translocation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005943> "reduced break-induced loss of heterozygosity via chromosomal translocation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005943> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005943> "decreased break-induced loss of heterozygosity via chromosomal translocation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005943> "FYPO:0005943")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005943> "This phenotype may be observed in diploid cells, or in cells that have two copies of one or more reporter loci but are otherwise haploid. Loss of heterozygosity associated with chromosomal translocation may result from allelic crossover or break-induced replication. In cells with this phenotype, loss of heterozygosity may or may not occur via a different mechanism, such as chromosomal truncation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005943> "decreased break-induced loss of heterozygosity via chromosomal translocation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005943> <http://purl.obolibrary.org/obo/FYPO_0005451>)

