# Class: <http://purl.obolibrary.org/obo/FYPO_0002306> (abnormal 5-phosphoribose 1-diphosphate binding)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002306> "A molecular function phenotype in which occurrence of 5-phosphoribose 1-diphosphate binding by a gene product (usually a protein) in a mutant is abnormal. The affected gene product may be encoded by the mutated gene, or by a different gene.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002306> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002306> "2013-06-20T15:05:41Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "CHEBI:17111") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002306> "abnormal 5-O-phosphono-alpha-D-ribofuranosyl diphosphate binding")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002306> "abnormal phosphoribosylpyrophosphate binding")
