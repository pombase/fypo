AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002005> "2013-02-27T14:11:12Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002005> "lobate nuclear envelope during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002005> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002005> "leaf-like nuclear envelope morphology")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002005> "lobate nuclear envelope during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002005> "FYPO:0002005")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002005> "This term differs from 'nuclear envelope protrusion present' (FYPO:0003788) in that a lobate envelope has a few deep fissures extending inward from the cytoplasm that appear to partially divide the nucleus into portions, whereas protrusions are smaller and extend outward from the bulk of the nucleus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002005> "lobate nuclear envelope")
