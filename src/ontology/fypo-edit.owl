AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004372> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004372> "decreased G2 DNA damage checkpoint during mitotic cell cycle")
