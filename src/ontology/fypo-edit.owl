AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002644> "decreased serine phosphorylation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002644> "reduced protein serine phosphorylation during vegetative growth")
