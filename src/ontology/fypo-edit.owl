AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007391> "decreased viability of aneuploid spores")
