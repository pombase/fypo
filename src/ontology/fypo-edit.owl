# Class: <http://purl.obolibrary.org/obo/FYPO_0000326> (abnormal mitotic sister chromatid biorientation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000326> "A cellular process phenotype in which the stable attachment of sister chromatids to microtubules emanating from opposite poles of the mitotic spindle during metaphase plate congression is abnormal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000326> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000326> "2011-05-11T01:51:05Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000326> "abnormal sister chromatid biorientation during mitosis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000326> "abnormal sister chromatid biorientation during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000326> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000326> "abnormal sister chromatid biorientation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000326> "FYPO:0000326")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000326> "This term is more specific than 'abnormal attachment of mitotic spindle microtubules to kinetochore' (FYPO:0004213) because sister chromatid biorientation normally occurs only as part of metaphase plate congression, not during other stages of mitosis. FYPO:0004213 can be used for abnormal attachment observed at any time during mitosis. Consider also annotating to 'unequal mitotic sister chromatid segregation' (FYPO:0003241) because a problem with biorientation usually results in unequal chromosome segregation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000326> "abnormal mitotic sister chromatid biorientation")
