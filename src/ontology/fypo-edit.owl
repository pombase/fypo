# Class: <http://purl.obolibrary.org/obo/FYPO_0004101> (lagging mitotic chromosomes, with complete sister chromatid separation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:17561805") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004101> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which sister chromatids do not move towards the spindle poles at the same time during mitosis prior to completion of chromosome segregation. Although one or more chromosomes remain distant from the spindle pole after the bulk of the DNA has separated, mitotic sister chromatid segregation does eventually go on to complete separation of chromosomes.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004101> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004101> "2014-12-02T15:38:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004101> "chromosome segregation defects, lagging mitotic chromosomes, with complete sister chromatid separation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004101> "lagging chromosomes, with complete sister chromatid separation, during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004101> "lagging mitotic chromosomes, with complete chromosome separation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004101> "lagging mitotic sister chromatids, with complete sister chromatid separation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004101> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004101> "lagging chromosomes, with complete sister chromatid separation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004101> "FYPO:0004101")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004101> "Chromosome lagging may reflect a delay in detachment of sister chromatids from each other ('chromatid separation' as defined by GO:0051306), polewards movement (GO:0007079), or both. In this phenotype, both processes are eventually completed, and the overall segregation process likely completes. Consider also annotating to 'unequal mitotic sister chromatid segregation' (FYPO:0003241) or one of its descendants, because chromosomes that lag at anaphase are often missegregated at telophase.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004101> "lagging mitotic chromosomes, with complete sister chromatid separation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004101> <http://purl.obolibrary.org/obo/FYPO_0000228>)

