############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000050> (part_of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/BFO_0000050> "Used in FYPO to identify phenotypes that are always observed in the context of another, usually larger-scale, phenotype.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/BFO_0000050> "BFO:0000050")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/BFO_0000050> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/BFO_0000050> "part_of")
AnnotationAssertion(oboInOwl:shorthand <http://purl.obolibrary.org/obo/BFO_0000050> "part_of")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000050> "part_of")

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000051> (has_part)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/BFO_0000051> "Used in FYPO to link phenotypes that are collections of features to phenotypes representing the features.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/BFO_0000051> "BFO:0000051")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/BFO_0000051> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/BFO_0000051> "has_part")
AnnotationAssertion(oboInOwl:shorthand <http://purl.obolibrary.org/obo/BFO_0000051> "has_part")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000051> "has_part")
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000051>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000066> (occurs in)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/BFO_0000066> "Used in FYPO to identify a location, usually a cellular component or cell type, within which a phenotype is observed or relevant.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/BFO_0000066> "BFO:0000066")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/BFO_0000066> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/BFO_0000066> "occurs_in")
AnnotationAssertion(oboInOwl:shorthand <http://purl.obolibrary.org/obo/BFO_0000066> "occurs_in")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000066> "occurs in")

# Object Property: <http://purl.obolibrary.org/obo/GOREL_0000001> (happens_during)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/GOREL_0000001> "Identifies a process, cell cycle stage or life stage during which a phenotype that affects an occurrent, i.e. a biological process or molecular function, is observed or relevant.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/GOREL_0000001> "GOREL:0000001")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/GOREL_0000001> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/GOREL_0000001> "happens_during")
AnnotationAssertion(oboInOwl:shorthand <http://purl.obolibrary.org/obo/GOREL_0000001> "happens_during")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GOREL_0000001> "happens_during")

# Object Property: <http://purl.obolibrary.org/obo/GOREL_0000002> (during)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/GOREL_0000002> "Identifies a process, cell cycle stage or life stage during which a phenotype is observed or relevant.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/GOREL_0000002> "GOREL:0000002")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/GOREL_0000002> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/GOREL_0000002> "during")
AnnotationAssertion(oboInOwl:shorthand <http://purl.obolibrary.org/obo/GOREL_0000002> "during")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GOREL_0000002> "during")

# Object Property: <http://purl.obolibrary.org/obo/GOREL_0000032> (exists_during)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/GOREL_0000032> "Identifies a process, cell cycle stage or life stage during which a phenotype that affects a continuant, such as a cellular component or the level of a substance, is observed or relevant.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/GOREL_0000032> "GOREL:0000032")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/GOREL_0000032> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/GOREL_0000032> "exists_during")
AnnotationAssertion(oboInOwl:shorthand <http://purl.obolibrary.org/obo/GOREL_0000032> "exists_during")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GOREL_0000032> "exists_during")

# Object Property: <http://purl.obolibrary.org/obo/GOREL_0000501> (occurs_at)

AnnotationAssertion(<http://purl.obolibrary.org/obo/fypo#usage> <http://purl.obolibrary.org/obo/GOREL_0000501> "This relation is not constrained with respect to whether the place where an event occurs completely surrounds, or is adjacent to, the location indicated. Example: chromatin silencing at centromere unfolds_around centromere : Repression of transcription of centromeric DNA by the formation of heterochromatin. Used in FYPO to identify a position where a phenotype is observed or relevant, usually a DNA or RNA sequence feature specified by a SO ID.")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/GOREL_0000501> "GOREL:0000501")
