# Class: <http://purl.obolibrary.org/obo/FYPO_0000033> (abnormal actomyosin contractile ring localization)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:1902405") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000033> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which actomyosin contractile ring localization is abnormal. Actomyosin contractile ring localization is the part of cytokinesis in which the actomyosin contractile ring is assembled and/or maintained in a specific location.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000033> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000033> "2011-03-29T05:53:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal actomyosin contractile ring localisation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal actomyosin contractile ring localization during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:1902405") Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal actomyosin contractile ring localization involved in mitotic cytokinesis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal actomyosin contractile ring positioning")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal cytokinetic contractile ring localization")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal mitotic contractile ring localization")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "cytokinesis defects, misplaced contractile ring")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000033> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal actomyosin contractile ring localization during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000033> "FYPO:0000033")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000033> "Note that the location of the contractile ring is determined by the location of the cell division site, so an abnormality in cell division site determination can be inferred from this phenotype. Consider also annotating to 'abnormal septum site selection' (FYPO:0002154) because if the contractile ring forms in an abnormal location, the septum will also do so. The positions of both the contractile ring and the septum are determined by the processes that select the site of cell division.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000033> "abnormal actomyosin contractile ring localization")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0000033> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000001> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_1902405>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
