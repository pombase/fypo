# Class: <http://purl.obolibrary.org/obo/FYPO_0006692> (cut with septum between unequally sized nuclei)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006692> "An inviable phenotype observed in the vegetative growth phase of the life cycle in which a cell undergoes septation despite abnormal mitotic sister chromatid separation, producing inviable daughter cells, and in which the septum forms so as to separate the nucleus into two unequal masses, each in one compartment.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006692> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006692> "2018-10-16T14:20:39Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006692> "cut with septum between unequally sized nuclei during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006692> "cut with unequally sized nuclei, one either side of septum")
