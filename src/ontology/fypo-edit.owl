# Class: <http://purl.obolibrary.org/obo/FYPO_0002206> (obsolete inviable swollen spore population)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002206> "OBSOLETE. A cell population phenotype in which none of the cells in a population of spores are viable, and all have a larger volume than normal. In a swollen cell, both length and diameter may be greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal. Inviable spores do not germinate.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0100001> <http://purl.obolibrary.org/obo/FYPO_0002206> "FYPO:0002150")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002206> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002206> "2013-06-05T13:51:00Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002206> "inviable population of swollen spores")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002206> "inviable spore population with increased cell volume")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002206> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002206> "inviable enlarged spore population")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002206> "inviable large spore population")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002206> "inviable spore population with increased cell size")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002206> "FYPO:0002206")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002206> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype plus a full-penetrance extension.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002206> "obsolete inviable swollen spore population")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002206> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002207> (inviable swollen spore)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002207> "A viability phenotype in which a spore is unable to survive under conditions in which wild type spores survive, and has a larger volume than normal. In a swollen cell, both length and diameter may be greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal. An inviable spore does not germinate.")
