AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004318> "FYPO:0004318")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004318> "abolished mitotic spindle assembly checkpoint")
