# Class: <http://purl.obolibrary.org/obo/FYPO_0000279> (obsolete formation of azygotic ascus upon sporulation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:16169489") Annotation(oboInOwl:hasDbXref "PMID:18780734") Annotation(oboInOwl:hasDbXref "PMID:20404563") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000279> "OBSOLETE. A sporulation phenotype in which azygotic asci form following conjugation and subsequent sporulation. Azygotic ascus formation occurs when meiosis takes place within a diploid cell rather than in a zygote produced by sporulation. Zygotes can resume vegetative growth and form colonies of diploid cells if returned to rich media before commitment to meiosis; under nitrogen starvation, diploid cells heterozygous for mating type will undergo azygotic meiosis. Azygotic asci have a characteristic linear morphology resembling that of a single vegetatively growing cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000279> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000279> "2011-04-19T04:37:01Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000279> "abnormal sporulation resulting in formation of azygotic asci")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000279> "formation of azygotic asci upon sporulation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000279> "sporulation defects, azygotic asci")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000279> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000279> "FYPO:0000279")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000279> "This term was made obsolete because it was incorrectly defined. Although the description in the text definition is accurate, azygotic sporulation is not necessarily an abnormal occurrence. The term was also used incorrectly in annotations.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000279> "obsolete formation of azygotic ascus upon sporulation")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0000279> "true"^^xsd:boolean)

