AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007963> "normal mating efficiency during nitrogen stress")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007963> <http://purl.obolibrary.org/obo/FYPO_0001147>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0007965> (increased spontaneous diploidization due to abolished sister chromatid separation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007965> "A cell phenotype observed in the vegetative growth phase of the life cycle in which heterothallic haploid cells spontaneously form cells with diploid DNA content after failing chromosome segregation and  consequently nuclear division. The nucleus is displaced from the cell center by actin cables, preventing chromosome cut and leading to diploidisation.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007965> "vw253")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007965> "2022-05-16T12:11:03Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0007965> "escape from mitotic catastrophe")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/FYPO_0007965> "PMID:33506191")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/FYPO_0007965> "PomBase:mlr")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007965> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007965> "FYPO:0007965")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007965> "increased spontaneous diploidization due to abolished sister chromatid separation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007965> <http://purl.obolibrary.org/obo/FYPO_0000252>)
