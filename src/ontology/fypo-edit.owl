AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006715> "2018-10-30T13:23:50Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006715> "large and small daughter nuclei during vegetative growth")
