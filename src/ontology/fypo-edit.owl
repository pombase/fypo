AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005207> "2016-01-19T14:11:22Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005207> "normal cell cycle regulation upon nitrogen source shift")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005207> "normal cell cycle regulation upon nitrogen source shift during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005207> "normal mitotic cell cycle regulation during cellular response to nitrogen source shift")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005207> "normal mitotic cell cycle regulation upon nitrogen source shift during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005207> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005207> "FYPO:0005207")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005207> "Good (or rich) nitrogen sources are distinguished from poor sources based on how readily nitrogen is assimilated into cellular metabolism. In microorganisms, good nitrogen sources generally support higher cell population growth rates than poor sources. In fission yeast, cells divide at a smaller size when grown on a poor nitrogen source than in nitrogen-rich media; proline is commonly used as a poor nitrogen source.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005207> "normal mitotic cell cycle regulation upon nitrogen source shift")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005207> <http://purl.obolibrary.org/obo/FYPO_0001928>)

