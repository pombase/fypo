# Class: <http://purl.obolibrary.org/obo/FYPO_0001971> (abnormal cell separation after cytokinesis resulting in chained cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:8873452") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001971> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which cell separation after cytokinesis is abnormal, and results in the formation of a chain of cells. Cells in the chain visually resemble wild-type cells, except that they remain connected, often via remnants of septum edging material, and may continue to undergo normal mitosis and septum formation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001971> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001971> "2013-02-07T15:15:49Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001971> "abnormal cell separation after cytokinesis resulting in chained cells during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000920") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001971> "abnormal mitotic cytokinetic cell separation resulting in chained cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001971> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001971> "abnormal cell separation after cytokinesis resulting in chained cells during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001971> "cell clumping")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001971> "clumped cells")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001971> "FYPO:0001971")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001971> "This phenotype usually results from a defect late in septum degradation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001971> "abnormal cell separation after cytokinesis resulting in chained cells")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001971> <http://purl.obolibrary.org/obo/FYPO_0000164>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0001972> (abnormal cell separation after cytokinesis resulting in septated cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:12654901") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001972> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which cell separation after cytokinesis is abnormal, and results in the formation of a septated cell. Nuclear division, contractile ring formation and constriction, and septum assembly are apparently normal, but the septum does not degrade. Additional rounds of nuclear division and cytokinesis may take place, resulting in the formation of a multiseptate cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001972> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001972> "2013-02-07T15:23:02Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001972> "abnormal cell separation after cytokinesis resulting in septated cell during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000920") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001972> "abnormal mitotic cytokinetic cell separation resulting in septated cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000920") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001972> "abnormal septum digestion after cytokinesis resulting in septated cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001972> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001972> "abnormal cell separation after cytokinesis resulting in septated cell during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001972> "boomerang shaped")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001972> "FYPO:0001972")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001972> "This phenotype usually results from a defect late in septum degradation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001972> "abnormal cell separation after cytokinesis resulting in septated cell")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001972> <http://purl.obolibrary.org/obo/FYPO_0000164>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0001973> (obsolete abnormal cell separation after cytokinesis, with abnormal nuclear division)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:3283148") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001973> "OBSOLETE. A cellular process phenotype observed in the vegetative growth phase of the life cycle in which nuclear division, cytokinesis and subsequent cell separation are abnormal, resulting in the formation of a cell in which an undivided mass of DNA is located on one side of the septum. The septum does not degrade.")
