# Class: <http://purl.obolibrary.org/obo/FYPO_0002644> (obsolete decreased protein serine phosphorylation during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002644> "OBSOLETE. A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the phosphorylation of serine residues in one or more specific proteins, or of specific protein sites, occurs to a lower extent than normal.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0100001> <http://purl.obolibrary.org/obo/FYPO_0002644> "FYPO:0001838")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002644> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002644> "2013-09-12T12:43:00Z")
