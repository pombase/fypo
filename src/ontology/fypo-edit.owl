# Class: <http://purl.obolibrary.org/obo/FYPO_0005792> (T-shaped cell during G0 to G2 transition)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005792> "A cell morphology phenotype in which a new growth zone forms along the lateral portion of the cell (often in the middle) before septation, such that a single cell grows in the form of the letter T, when the cell undergoes transition from G0 phase to G2. Cell length is normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005792> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005792> "2016-11-23T13:01:05Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during cell cycle re-entry at G2")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during cell quiescence to G2 transition")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during exit from cell quiescence into G2")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during quiescence to G2 transition")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during recovery from quiescence following G2 arrest")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during recovery from quiescence into G2")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005792> "cell morphology, T shaped during G0 to G2 transition")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005792> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005792> "FYPO:0005792")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005792> "Cells enter quiescence (G0) from G2 when starved for glucose, and can re-enter the cell cycle at G2 when glucose again becomes available. A T-shaped cell may septate perpendicular to the normal septation axis, and divide to form normal-shaped daughter cells. Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'viable cell population' (FYPO:0002058) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005792> "T-shaped cell during G0 to G2 transition")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005792> <http://purl.obolibrary.org/obo/FYPO_0005810>)

