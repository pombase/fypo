# Class: <http://purl.obolibrary.org/obo/FYPO_0005810> (T-shaped cell during recovery from quiescence)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005810> "A cell morphology phenotype in which a new growth zone forms along the lateral portion of the cell (often in the middle) before septation, such that a single cell grows in the form of the letter T, when the cell undergoes transition from G0 phase, re-entering the cell cycle phase from which it entered G0 (G1 or G2). Cell length is normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005810> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005810> "2016-11-25T14:22:18Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005810> "T-shaped cell during cell cycle re-entry")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005810> "T-shaped cell during exit from cell quiescence")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005810> "T-shaped cell during transition from cell quiescence")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005810> "cell morphology, T shaped during recovery from quiescence")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005810> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005810> "T-shaped cell during recovery from stationary phase")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005810> "FYPO:0005810")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005810> "A T-shaped cell may septate perpendicular to the normal septation axis, and divide to form normal-shaped daughter cells. Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'viable cell population' (FYPO:0002058) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005810> "T-shaped cell during recovery from quiescence")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005810> <http://purl.obolibrary.org/obo/FYPO_0005566>)

