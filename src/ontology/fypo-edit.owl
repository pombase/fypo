# Class: <http://purl.obolibrary.org/obo/FYPO_0002848> (T-shaped cell during recovery from stationary phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002848> "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which a new growth zone forms along the lateral portion of the cell (often in the middle) before septation, such that a single cell grows in the form of the letter T, when the cell population has been in stationary phase and is then placed in conditions that allow recovery.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002848> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002848> "2013-11-08T12:07:19Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002848> "T-shaped cell during vegetative growth following stationary phase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002848> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002848> "T-shaped cell during recovery from stationary phase during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002848> "FYPO:0002848")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002848> "One distinction between T-shaped and other branched cells is that in T-shaped cells the new growth zone forms before NETO.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002848> "T-shaped cell during recovery from stationary phase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002848> <http://purl.obolibrary.org/obo/FYPO_0007379>)

