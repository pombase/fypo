AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:32502403") Annotation(oboInOwl:hasDbXref "PMID:32848252") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007546> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which nuclear envelope division does not occur. Nuclear envelope division takes place at the end of mitosis; the nuclear envelope undergoes localized breakdown in the nuclear bridge midzone and the ends are sealed and retrieved into the envelopes of the separated daughter nuclei. When nuclear envelope division does not occur, the two DNA masses remain linked by the nuclear bridge, and may coalesce back into a single nucleus.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007546> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007546> "2020-12-09T15:09:34Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007546> "abolished NE division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007546> "abolished nuclear envelope division during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:32502403") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007546> "failed nuclear envelope division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007546> "nuclear envelope division abolished")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007546> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007546> "abolished nuclear envelope division during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007546> "FYPO:0007546")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007546> "abolished nuclear envelope division")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007546> <http://purl.obolibrary.org/obo/FYPO_0000815>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0007547> (abnormal nuclear pore localization to mitotic nuclear bridge midzone membrane)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:32502403") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007547> "A localization phenotype observed in the vegetative growth phase of the life cycle in which nuclear pore localization to the portion of the nuclear envelope enclosing the mitotic nuclear bridge is abnormal, resulting in an abnormal distribution of nuclear pores in the bridge envelope. The nuclear bridge is a narrow constricted region of the nucleus that forms around the mitotic spindle during anaphase. Normally, nuclear pores that lack baskets are found in the midzone of the nuclear bridge.")
