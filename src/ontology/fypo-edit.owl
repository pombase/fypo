# Class: <http://purl.obolibrary.org/obo/FYPO_0007123> (unbundled spindle during mitotic prophase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:31615768") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007123> "A physical cellular phenotype observed during mitotic prophase (in the vegetative growth phase of the life cycle) in which the mitotic spindle has two poles, but spindle microtubules (MTs) are not aligned into parallel or anti-parallel bundles. Instead, MTs extend in random directions from the asters, and the spindle does not elongate.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0007123> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0007123> "2019-10-30T14:45:17Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007123> "unbundled spindle during mitotic prophase during prophase of mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007123> "unbundled spindle during mitotic prophase during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007123> "unbundled spindle microtubules during mitotic prophase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007123> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007123> "FYPO:0007123")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007123> "In images of thin spindles, polar microtubules may appear not to reach continuously from pole to pole.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007123> "unbundled spindle during mitotic prophase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007123> <http://purl.obolibrary.org/obo/FYPO_0001574>)

