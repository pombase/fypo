AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001047> "2012-05-11T01:34:45Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001047> "mitotic catastrophe during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001047> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001047> "mitotic catastrophe during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001047> "FYPO:0001047")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001047> "This term was made obsolete because \"mitotic catastrophe\" has not been clearly defined for fission yeast.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001047> "obsolete mitotic catastrophe")
