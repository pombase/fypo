# Class: <http://purl.obolibrary.org/obo/FYPO_0001839> (normal minichromosome loss)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001839> "A cell phenotype in which minichromosomes are lost at the same frequency as in wild-type cells. Minichromosome loss occurs when one or both daughter cells do not inherit copies of a minichromosome from the mother cell, and may result from failure of minichromosome replication or segregation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001839> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001839> "2012-12-06T16:04:43Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001839> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001839> "FYPO:0001839")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001839> "In fission yeast, a minichromosome is a large portion of a chromosome, usually about half of chromosome 3, that replicates and segregates autonomously. For smaller autonomously replicating and segregating constructs, consider 'normal plasmid loss' (FYPO:0001790).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001839> "normal minichromosome loss")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001839> <http://purl.obolibrary.org/obo/FYPO_0001312>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0001840> (increased minichromosome loss during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001840> "A cell phenotype in which minichromosomes are lost at a higher frequency than normal during the vegetative growth phase of the life cycle. Minichromosome loss occurs when one or both daughter cells do not inherit copies of a minichromosome from the mother cell, and may result from failure of minichromosome replication or segregation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001840> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001840> "2012-12-06T16:08:24Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001840> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001840> "increased minichromosome loss during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001840> "mitotic minichromosome maintenance defect")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001840> "FYPO:0001840")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001840> "Note that in budding yeast, increased plasmid loss is often called a minichromosome maintenance defect, because \"minichromosome\" is roughly synonymous with an autonomously replicated and segregated plasmid in that organism. In fission yeast, a minichromosome is a large portion of a chromosome, usually about half of chromosome 3, that replicates and segregates autonomously. For smaller autonomously replicating and segregating constructs, consider 'increased plasmid loss' (FYPO:0000786).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001840> "increased minichromosome loss during vegetative growth")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001840> <http://purl.obolibrary.org/obo/FYPO_0001320>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001840> <http://purl.obolibrary.org/obo/FYPO_0001859>)

