AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000780> "Use this term if there is evidence, such as labeled nucleotide incorporation, showing that transcription rather than RNA stability is affected; otherwise, use 'increased RNA level' (FYPO:0000825).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000780> "increased transcription during vegetative growth")
