AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004361> "haploid meiosis during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004361> "haploid sporulation during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004361> "meiosis in haploid during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004361> "sporulation in haploid during nitrogen starvation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004361> "FYPO:0004361")
