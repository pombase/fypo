AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003812> "FYPO:0003812")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003812> "abnormal nucleosome positioning at stress response genes")
