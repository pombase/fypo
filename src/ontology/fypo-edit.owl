# Class: <http://purl.obolibrary.org/obo/FYPO_0000228> (lagging mitotic chromosomes)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:11809834") Annotation(oboInOwl:hasDbXref "PMID:20211136") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000228> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which sister chromatids do not move towards the spindle poles at the same time during mitosis, but instead one or more chromosomes remain distant from the spindle pole after the bulk of the DNA has separated. Mitotic sister chromatid segregation may stop before completing separation of chromosomes, or may eventually be completed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000228> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000228> "2011-04-19T02:59:38Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000228> "chromosome segregation defects, lagging mitotic chromosomes")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000228> "lagging chromosomes during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000228> "lagging mitotic sister chromatids")
