# Class: <http://purl.obolibrary.org/obo/FYPO_0003210> (mislocalized, misoriented septum)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003210> "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which a cell has a septum that is in an abnormal location and is not perpendicular to the long axis of the cell. The normal location is at the midpoint of the long axis of the cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003210> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003210> "2014-03-19T10:50:08Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "abnormal septum location and orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "abnormal septum position and orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "asymmetric, misoriented septum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "asymmetrically located, misoriented septum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "mislocalised, misoriented septum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "mislocalized, misoriented septum during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "misplaced, misoriented septum")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003210> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "abnormal septum localization and orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "abnormal septum positioning and orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003210> "mislocalized, misoriented septum during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003210> "FYPO:0003210")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003210> "Note that the location of the septum is determined by the location of the contractile ring, which in turn is determined by the location of the cell division site, so an abnormality in cell division site determination can be inferred from this phenotype. Consider also annotating to 'mislocalized actomyosin contractile ring' (FYPO:0001369) because if the contractile ring forms in an abnormal location, the septum will also do so.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003210> "mislocalized, misoriented septum")
