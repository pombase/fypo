AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000920") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001973> "abnormal mitotic cytokinetic cell separation, with abnormal nuclear division")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001973> "fission_yeast_phenotype")
