# Class: <http://purl.obolibrary.org/obo/FYPO_0000014> (tapered cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000014> "A cell morphology phenotype in which the cell tapers at one end to a diameter smaller than the other. The cell diameter at the narrow end is smaller than that of a wild-type cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000014> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000014> "2011-03-29T05:53:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000014> "bottle-shaped cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000014> "cell morphology, bottle/skittle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000014> "skittle-shaped cell")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000014> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000014> "FYPO:0000014")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000014> "Note that the difference between 'tapered cell' (FYPO:0000014) and 'spindle-shaped cell' (FYPO:0007230) is that a tapered cell is narrow at only one end, whereas a spindle-shaped cell is narrow at both ends.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000014> "tapered cell")
