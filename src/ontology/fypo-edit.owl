AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002549> "decreased vegetative cell population growth during cellular response to stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002549> "hypersensitive to stress")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002549> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "SGD:phenotype_annotation") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002549> "stress resistance: decreased")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002549> "FYPO:0002549")
AnnotationAssertion(oboInOwl:inSubset <http://purl.obolibrary.org/obo/FYPO_0002549> <http://purl.obolibrary.org/obo/fypo#qc_do_not_manually_annotate>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002549> "This is a high-level term whose primary purpose is to organize terms beneath it in the ontology, and we expect that it will not be used for direct annotations. Please consider using a more specific term to annotate each phenotype. Use a descendant of this term if you have assayed growth of cells exposed to a stress in culture. If you have assayed the response to the stress at the subcellular or molecular level, consider annotating to a descendant of 'abnormal cellular response to stress' (FYPO:0000162).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002549> "sensitive to stress")
