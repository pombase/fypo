# Class: <http://purl.obolibrary.org/obo/FYPO_0003095> (viable elongated vegetative cell, with progressive elongation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:24013504") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003095> "A cell morphology phenotype in which a vegetative cell is viable and elongated, and continues to become longer over successive generations. The cell also undergoes mitosis beginning when the cell is longer than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003095> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003095> "2014-02-19T10:34:57Z")
