AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006265> "large vacuoles large vacuoles present following cellular hypotonic response during mitotic cell cycle")
