# Class: <http://purl.obolibrary.org/obo/FYPO_0005726> (abolished deactivation of mitotic spindle assembly checkpoint)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:19592249") Annotation(oboInOwl:hasDbXref "PMID:21664573") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005726> "A cell cycle checkpoint phenotype in which deactivation of the mitotic spindle assembly checkpoint does not occur. The mitotic spindle assembly checkpoint normally delays the metaphase/anaphase transition of a mitotic nuclear division until the spindle is correctly assembled and chromosomes are attached to the spindle.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005726> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005726> "2016-11-02T13:30:06Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005726> "abolished deactivation of mitotic cell cycle spindle assembly checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:1902426") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005726> "abolished mitotic spindle assembly checkpoint deactivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:1902426") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005726> "abolished mitotic spindle assembly checkpoint silencing")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005726> "deactivation of mitotic spindle assembly checkpoint abolished")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005726> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005726> "FYPO:0005726")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005726> "The difference between this term and constitutive activation of mitotic spindle assembly checkpoint (FYPO:000) is that this term describes cells in which the checkpoint is not active at first, but once activated the checkpoint is not deactivated, whereas FYPO:0007 describes cells in which the checkpoint is always active, i.e. the checkpoint is never observed to be \"off\". Checkpoint activation in a mutant usually implies that the mutation is causing problems that the checkpoint detects.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005726> "abolished deactivation of mitotic spindle assembly checkpoint")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0005726> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001558> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000002> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_1902426>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005726> <http://purl.obolibrary.org/obo/FYPO_0000168>)

