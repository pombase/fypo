AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003213> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:10087262") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003213> "side-by-side cells")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003213> "FYPO:0003213")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003213> "explosive cytokinetic cell separation resulting in vegetative cell lysis")
