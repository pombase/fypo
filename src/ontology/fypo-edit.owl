# Class: <http://purl.obolibrary.org/obo/FYPO_0005428> (delayed onset of UV-damage excision repair)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0070914") Annotation(oboInOwl:hasDbXref "PMID:15329725") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005428> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which UV-damage excision repair begins later than normal. UV-damage excision repair is a DNA repair process that is initiated by an endonuclease that introduces a single-strand incision immediately 5' of a UV-induced damage site, and that acts on both cyclobutane pyrimidine dimers (CPDs) and pyrimidine-pyrimidone 6-4 photoproducts (6-4PPs).")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005428> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005428> "2016-06-06T13:28:39Z")
