# Class: <http://purl.obolibrary.org/obo/FYPO_0006909> (mitotic G1/S phase transition at small cell size)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:872890") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006909> "A cell cycle phenotype in which the G1/S transition of the mitotic cell cycle occurs at a smaller cell size than normal after the cell has been arrested in G1 phase due to nitrogen starvation. The cell remains arrested in G1.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006909> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006909> "2019-06-10T15:02:50Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006909> "G1/S phase transition at small cell size during mitotic cell cycle")
