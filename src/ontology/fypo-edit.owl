AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002890> "2013-11-19T12:50:32Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002890> "abnormal horsetail nuclear morphology")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002890> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002890> "FYPO:0002890")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002890> "Note that an abnormal nucleus organization process may, but does not necessarily, result in abnormal nuclear morphology. Consider also annotating to 'abnormal horsetail movement' (FYPO:0000197).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002890> "abnormal horsetail nucleus morphology")
