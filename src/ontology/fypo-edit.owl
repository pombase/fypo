# Class: <http://purl.obolibrary.org/obo/FYPO_0007332> (abolished increase in protein phosphorylation during cellular response to stress in presence of small molecule)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:31932483") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007332> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which an increase in the phosphorylation of one or more specific proteins that would normally occur when cells are subjected to a stress in the presence of a specific small molecule does not occur under the same circumstances.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0007332> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0007332> "2020-04-17T16:44:48Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007332> "abolished increase in protein phosphorylation during cellular response to stress in presence of small molecule during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007332> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:31932483") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007332> "abolished increase in protein phosphorylation by small molecule")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007332> "abolished increase in protein phosphorylation during cellular response to stress in presence of small molecule during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007332> "FYPO:0007332")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007332> "Use this term when a difference between wild type and a mutant is seen only when both the stress and the small molecule are present. An example is protein phosphorylation under oxidative stress in the presence of the small molecule INR119. We recommend noting which protein(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007332> "abolished increase in protein phosphorylation during cellular response to stress in presence of small molecule")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007332> <http://purl.obolibrary.org/obo/FYPO_0002033>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0007333> (abolished chromatin silencing)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007333> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which chromatin silencing does not occur. Chromatin silencing is the observed effect of processes that repress transcription in a region of the genome that is normally assembled into heterochromatin or CENP-A-containing chromatin (the latter is found at the centromere central core).")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0007333> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0007333> "2020-04-21T13:38:04Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007333> "chromatin silencing abolished")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007333> "chromatin silencing abolished during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007333> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007333> "abolished chromatin silencing during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007333> "FYPO:0007333")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007333> "Chromatin silencing phenotypes may reflect the assembly or maintenance of heterochromatin. See the GO cellular component term 'heterochromatin' (GO:0000792), and the biological process term 'heterochromatin organization' (GO:0070828).")
