AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001989> "2013-02-13T17:18:14Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001989> "decreased growth during cellular response to low pH")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001989> "decreased vegetative cell population growth during cellular response to low pH")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001989> "hypersensitive to low pH")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001989> "sensitive to low pH during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001989> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001989> "sensitive to low pH during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001989> "FYPO:0001989")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001989> "Also see 'sensitive to acidity' (FYPO:0000722).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001989> "sensitive to low pH")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001989> <http://purl.obolibrary.org/obo/FYPO_0000304>)

