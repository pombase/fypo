# Class: <http://purl.obolibrary.org/obo/FYPO_0001230> (abnormal cell cortex morphology during nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0005938") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001230> "A physical cellular phenotype in which the size, shape, or structure of all or part of the cell cortex is abnormal when the cell is subject to nitrogen starvation. The cell cortex is the region of a cell that lies just beneath the plasma membrane.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001230> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001230> "2012-07-16T13:52:15Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001230> "abnormal cell cortex morphology during nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001230> "abnormal cell cortex morphology during nitrogen deprivation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001230> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001230> "FYPO:0001230")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001230> "Note that an abnormal cell cortex organization process may, but does not necessarily, result in abnormal cell cortex morphology. This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001230> "abnormal cell cortex morphology during nitrogen starvation")
