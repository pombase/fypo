AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000152> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000152> "2011-04-13T03:34:54Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000152> "abnormal cellular response to nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000152> "abnormal cellular response to nitrogen deprivation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000152> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000152> "FYPO:0000152")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000152> "This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. Use this term if you have assayed the response to nitrogen starvation at the subcellular or molecular level. If you have assayed growth of cells exposed to nitrogen starvation in culture, use 'sensitive to nitrogen starvation' (FYPO:0002124).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000152> "abnormal cellular response to nitrogen starvation")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0000152> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0006995>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0000152> <http://purl.obolibrary.org/obo/FYPO_0000713>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0000153> (obsolete clumped colony morphology)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15194814") Annotation(oboInOwl:hasDbXref "PomBase:ch") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000153> "OBSOLETE. A colony morphology phenotype in which cells form clumps. Clumping may result from incomplete hydrolysis of septum edging material, causing cells to remain attached via remnants of the septum edging, or from cell-cell adhesion between cells that do not have a shared origin.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000153> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000153> "2011-04-19T02:50:53Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000153> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000153> "FYPO:0000153")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000153> "This term was made obsolete because it was added to map an out-of-date controlled vocabulary term, and unhelpfully groups two fairly unrelated phenomena.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000153> "obsolete clumped colony morphology")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0000153> "true"^^xsd:boolean)

