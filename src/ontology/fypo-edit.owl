# Class: <http://purl.obolibrary.org/obo/FYPO_0007171> (normal cell cortex morphology during meiotic prophase I)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0005938") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007171> "A physical cellular phenotype in which the size, shape, and structure of the cell cortex are normal during prophase of the first meiotic nuclear division. The cell cortex is the region of a cell that lies just beneath the plasma membrane.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0007171> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0007171> "2019-12-09T14:07:55Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007171> "normal cell cortex morphology during prophase I")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007171> "normal cell cortex morphology during prophase of meiosis I")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007171> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007171> "FYPO:0007171")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007171> "Note that an abnormal cell cortex organization process may, but does not necessarily, result in abnormal cell cortex morphology. This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007171> "normal cell cortex morphology during meiotic prophase I")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0007171> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0007128>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0005938>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000461>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007171> <http://purl.obolibrary.org/obo/FYPO_0001231>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0007172> (stationary phase viability unaffected by micafungin)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:31601154") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007172> "A cell population phenotype in which the proportion of cells in the population remains viable after entering stationary phase does not change in the presence of micafungin. Normally, wild-type cell populations survive longer in the presence of micafungin than in its absence.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0007172> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0007172> "2019-12-09T14:47:41Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007172> "loss of stationary phase viability extension in presence of micafungin")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007172> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007172> "chronological lifespan unaffected by micafungin")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007172> "loss of chronological lifespan extension by micafungin")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007172> "FYPO:0007172")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007172> "Although each cell has a replicative lifespan in that it divides a certain number of times and then dies, replicative lifespan is often measured at the population level, where it is defined by the number of generations at which 50% of the starting cells are dead.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007172> "stationary phase viability unaffected by micafungin")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007172> <http://purl.obolibrary.org/obo/FYPO_0000003>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007172> <http://purl.obolibrary.org/obo/FYPO_0001985>)

