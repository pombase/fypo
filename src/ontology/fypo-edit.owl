AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007155> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007155> "FYPO:0007155")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007155> "This term was made obsolete because it is not an accurate description of an observed phenotype.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007155> "obsolete ectopic activation of mitotic cell cycle spindle assembly checkpoint")
