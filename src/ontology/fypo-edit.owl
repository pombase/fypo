# Class: <http://purl.obolibrary.org/obo/FYPO_0004162> (loss of viability upon glucose starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004162> "A cell population phenotype in which a smaller than normal proportion of cells in the population remains viable when cells the population are subject to glucose starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004162> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004162> "2014-12-09T14:38:44Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004162> "decreased viability upon glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004162> "loss of cell population viability upon glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004162> "loss of viability upon glucose depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004162> "loss of viability upon glucose deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004162> "reduced viability upon glucose starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004162> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004162> "loss of viability upon glucose limitation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004162> "FYPO:0004162")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004162> "Use this term to annotate experiments in which a culture is grown under glucose-depleted conditions, and then the number of cells viable enough to form a colony upon return to conditions supporting vegetative growth is measured and compared to wild type. Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004162> "loss of viability upon glucose starvation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004162> <http://purl.obolibrary.org/obo/FYPO_0000244>)

