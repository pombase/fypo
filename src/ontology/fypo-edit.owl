AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006195> "decreased number of elongated microtubule bundles curved around cell end during vegetative growth")
