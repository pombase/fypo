AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004511> "long curved cytoplasmic microtubules during mitotic interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004511> "long curved interphase cytoplasmic microtubules")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004511> "long curved interphase microtubules during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004511> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004511> "FYPO:0004511")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004511> "In severe instances of this phenotype, microtubules grow long enough to curve around the cell tip.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004511> "long curved interphase microtubules")
