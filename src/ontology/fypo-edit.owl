# Class: <http://purl.obolibrary.org/obo/FYPO_0007859> (nuclear division in absence of mitotic spindle)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:20967237") Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007859> "A cellular process phenotype in which the nucleus divides into two or more fragments, each enclosed by nuclear envelope and containing a DNA mass, in a cell that does not form a mitotic spindle or undergo cytokinesis. In these cells, the nucleus does not elongate into a dumbbell shape, but instead the nuclear envelope takes on a ruffled aspect and then eventually pinches into two nuclear masses.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007859> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007859> "2021-09-28T13:00:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007859> "nuclear division in absence of mitotic spindle during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007859> "nuclear fission")
