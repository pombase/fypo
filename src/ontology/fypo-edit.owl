# Class: <http://purl.obolibrary.org/obo/FYPO_0001488> (sensitive to protamine sulfate)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001488> "A phenotype observed in the vegetative growth phase of the life cycle in which cells show increased sensitivity to protamine sulfate. A protamine is any of a group of simple proteins that yield basic amino acids on hydrolysis, and forms a complex with heparin. Cells stop growing (and may die) at a concentration of protamine sulfate that allows wild type cells to grow.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001488> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001488> "2012-08-30T13:32:12Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001488> "hypersensitive to protamine sulfate")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001488> "sensitive to protamine sulfate during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001488> "sensitive to protamine sulphate")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001488> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001488> "sensitive to protamine sulfate during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001488> "FYPO:0001488")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001488> "sensitive to protamine sulfate")
