AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004168> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004168> "2014-12-09T15:02:19Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004168> "normal cell population viability in stationary phase during glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004168> "normal viability in stationary phase during glucose depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004168> "normal viability in stationary phase during glucose deprivation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004168> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004168> "normal viability in stationary phase during glucose limitation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004168> "FYPO:0004168")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004168> "Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004168> "normal viability in stationary phase during glucose starvation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004168> <http://purl.obolibrary.org/obo/FYPO_0001310>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004168> <http://purl.obolibrary.org/obo/FYPO_0002057>)

