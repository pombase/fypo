AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002226> "2013-06-05T16:52:35Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002226> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002226> "FYPO:0002226")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002226> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002226> "obsolete inviable microcolony, abnormal cell shape, normal cell size")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002226> "true"^^xsd:boolean)

