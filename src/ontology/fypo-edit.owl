# Class: <http://purl.obolibrary.org/obo/FYPO_0009103> (increased actomyosin contractile ring recoil distance after ring ablation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0009103> "A cell phenotype in which the recoil distance of the cytokynetic ring after ring ablation is increased with respect to wild type. Experimentally, a localised cut or ablation is typically achieved using a laser. This distance, in combination with the timing of recoil are used to compute effective stiffness and drag of the ring components. See PMID:36980258.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0009103> "PomBase:mlr")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0009103> "2023-06-29T10:36:53Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0009103> "increased cytokinetic ring recoil distance after laser ablation")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/FYPO_0009103> "PMID:36980258")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0009103> "increased actomyosin contractile ring recoil distance after ring ablation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0009103> <http://purl.obolibrary.org/obo/FYPO_0004736>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0009104> (increased actomyosin contractile ring recoil time after ring ablation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0009104> "A cell phenotype in which the recoil time of the cytokynetic ring after ring ablation is increased with respect to wild type. Experimentally, a localised cut or ablation is typically achieved using a laser. The recoil time is the time it takes the recoil to stop after laser ablation. This timing, in combination with the recoil distance are used to compute effective stiffness and drag of the ring components. See PMID:36980258.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0009104> "PomBase:mlr")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0009104> "2023-06-29T10:38:29Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0009104> "increased cytokinetic ring recoil distance after laser ablation")
AnnotationAssertion(oboInOwl:hasDbXref <http://purl.obolibrary.org/obo/FYPO_0009104> "PMID:36980258")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0009104> "increased actomyosin contractile ring recoil time after ring ablation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0009104> <http://purl.obolibrary.org/obo/FYPO_0004736>)

