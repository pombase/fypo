AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007883> "decreased cleavage-dependent termination of RNA polymerase II transcription during mitotic cell cycle")
