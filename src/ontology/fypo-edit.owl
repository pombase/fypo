# Class: <http://purl.obolibrary.org/obo/FYPO_0004721> (obsolete decreased rate of microtubule depolymerization at minus end)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0036078") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004721> "OBSOLETE. A cellular process phenotype observed in the vegetative growth phase of the life cycle in which minus-end specific microtubule depolymerization, i.e. the removal of tubulin dimers from the minus end of a microtubule, occurs at a lower rate, or speed, than normal.")
AnnotationAssertion(oboInOwl:consider <http://purl.obolibrary.org/obo/FYPO_0004721> "FYPO:0008006")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004721> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004721> "2015-07-27T11:56:31Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased microtubule depolymerization rate at minus end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased rate of microtubule depolymerisation at minus end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased rate of microtubule depolymerization at minus end during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0036078") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased rate of minus-end specific microtubule depolymerization")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "reduced rate of microtubule depolymerization at minus end")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004721> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased microtubule minus end shrinkage")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased rate of microtubule catastrophe at minus end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "decreased rate of microtubule depolymerization at minus end during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004721> "increased microtubule stability")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004721> "FYPO:0004721")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004721> "In wild-type cells, microtubule minus ends are capped by the gamma-tubulin complex (they are not dynamic, they don't grow or shrink), so the minus end depolymerisation speed of the wild type in normal conditions cannot be measured and compared. It is possible to measure shrinkage speeds of minus ends in wild-type cells, specifically using laser ablation (cutting microtubules). This leads to minus end depolymerisation. It could be that in a certain study this minus end depolymerisation is compared in two genetic backgrounds. In that case, however, the phenotype could specify \"after laser ablation\".")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004721> "obsolete decreased rate of microtubule depolymerization at minus end")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0004721> "true"^^xsd:boolean)

