AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002371> "FYPO:0002371")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002371> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
