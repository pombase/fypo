# Class: <http://purl.obolibrary.org/obo/FYPO_0004175> (decreased mating efficiency in h- cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:8668157") Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004175> "A biological process phenotype in which the observed mating efficiency, as determined by counting zygotes, asci, and sometimes spores, is lower than normal in cells of the h- mating type.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004175> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004175> "2014-12-16T15:16:01Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004175> "reduced mating efficiency in h- cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004175> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004175> "FYPO:0004175")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004175> "Note that mating efficiency is often measured by counting zygotes plus asci, sometimes also including spores, so a change in measured mating efficiency may reflect a change in conjugation frequency (see FYPO:0000031 and its descendants), a change in sporulation (see FYPO:0000121 and its descendants), or both. For this reason, this term is not a child of 'mating phenotype' (FYPO:0000031).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004175> "decreased mating efficiency in h- cells")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004175> <http://purl.obolibrary.org/obo/FYPO_0000708>)

