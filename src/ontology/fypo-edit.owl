# Class: <http://purl.obolibrary.org/obo/FYPO_0007437> (constitutive activation of mitotic spindle assembly checkpoint)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:28017606") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007437> "A cell cycle checkpoint phenotype in which the mitotic spindle assembly checkpoint is activated continuously. The mitotic spindle assembly checkpoint normally delays the metaphase/anaphase transition of a mitotic nuclear division until the spindle is correctly assembled and chromosomes are attached to the spindle.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007437> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007437> "2020-07-27T10:59:55Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007437> "constitutive activation of mitotic cell cycle spindle assembly checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007437> "constitutively activated of mitotic spindle assembly checkpoint")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007437> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007437> "FYPO:0007437")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007437> "The difference between this term and abolished deactivation of mitotic spindle assembly checkpoint (FYPO:0005726) is that this term describes cells in which the checkpoint is always active, i.e. the checkpoint is never observed to be \"off\", whereas FYPO:0005726 describes cells in which the checkpoint is not active at first, but once activated the checkpoint is not deactivated.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007437> "constitutive activation of mitotic spindle assembly checkpoint")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007437> <http://purl.obolibrary.org/obo/FYPO_0000168>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0007438> (premature activation of mitotic spindle assembly checkpoint)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:28017606") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007438> "A cell cycle checkpoint phenotype in which activation of the mitotic spindle assembly checkpoint begins earlier than normal. The mitotic spindle assembly checkpoint normally delays the metaphase/anaphase transition of a mitotic nuclear division until the spindle is correctly assembled and chromosomes are attached to the spindle.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007438> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007438> "2020-07-27T11:14:54Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007438> "advanced activation of mitotic spindle assembly checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007438> "premature activation of mitotic cell cycle spindle assembly checkpoint")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007438> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007438> "FYPO:0007438")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007438> "premature activation of mitotic spindle assembly checkpoint")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0007438> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000694> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000002> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0007094>))))
