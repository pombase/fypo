# Class: <http://purl.obolibrary.org/obo/FYPO_0002210> (obsolete inviable microcolony, tapered cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002210> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells that taper at one end to a diameter smaller than the other. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002210> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002210> "2013-06-05T14:18:25Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002210> "inviable microcolony, bottle/skittle cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002210> "inviable microcolony, skittle-shaped cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002210> "inviable microcolony, tapered vegetative cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002210> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002210> "FYPO:0002210")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002210> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002210> "obsolete inviable microcolony, tapered cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002210> "true"^^xsd:boolean)

