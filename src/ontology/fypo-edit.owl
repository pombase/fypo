# Class: <http://purl.obolibrary.org/obo/FYPO_0001006> (inviable elongated multinucleate vegetative cell with central constriction)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:8834798") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001006> "A cell phenotype observed in the vegetative growth phase of the life cycle in which a cell contains more than one nucleus, is elongated, is inviable, and has an abnormal shape featuring a constriction at the center of the cell, corresponding to the cell division site. In a cell with this phenotype, the diameter at the ends may be much greater than in wild-type cells. Septal material may accumulate in patches at the cell surface, but no septum forms.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001006> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001006> "2012-04-25T04:07:50Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "inviable elongated multinucleate cell with central constriction during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "inviable elongated multinucleate vegetative cell with constricted region at cell division site")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "lethal; elongated multinucleate vegetative cell with central constriction")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001006> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "elongated, multinucleate dumbbell-shaped cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "inviable elongated multinucleate vegetative cell with central constriction during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "inviable, elongated, multinucleate dumbbell-shaped vegetative cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "long, multinucleate dumbbell-shaped cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001006> "multinucleate dumbbell-shaped cell")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001006> "FYPO:0001006")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001006> "Note that if you have done an experiment that assays the viability of a population of cells, such as looking at colony growth or growth in liquid culture, you should also annotate to 'inviable cell population' (FYPO:0002059) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001006> "inviable elongated multinucleate vegetative cell with central constriction")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0001006> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000061>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000779>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000949>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001122>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0001489>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0072690>))))
