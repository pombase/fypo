# Class: <http://purl.obolibrary.org/obo/FYPO_0004587> (abolished cell population growth on urea nitrogen source)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004587> "A vegetative cell population growth phenotype in which a cell population does not grow in a medium containing urea as the nitrogen source.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004587> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004587> "2015-04-29T11:59:27Z")
