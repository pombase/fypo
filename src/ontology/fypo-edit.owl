AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003438> "mitotic G1/S transition delay following nitrogen starvation-induced G1 phase arrest")
