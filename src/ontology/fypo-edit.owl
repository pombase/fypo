# Class: <http://purl.obolibrary.org/obo/FYPO_0005453> (abolished break-induced loss of heterozygosity via chromosomal translocation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:17724078") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005453> "A cell phenotype observed in the vegetative growth phase of the life cycle in which chromosomal translocation that would result in the loss of one of two different alleles of a gene does not occur.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005453> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005453> "2016-06-22T15:47:13Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005453> "abolished break-induced loss of heterozygosity via chromosomal translocation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005453> "break-induced loss of heterozygosity via chromosomal translocation abolished")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005453> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005453> "abolished break-induced loss of heterozygosity via chromosomal translocation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005453> "FYPO:0005453")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005453> "This phenotype may be observed in diploid cells, or in cells that have two copies of one or more reporter loci but are otherwise haploid. Loss of heterozygosity associated with chromosomal translocation may result from allelic crossover or break-induced replication. In cells with this phenotype, loss of heterozygosity may or may not occur via a different mechanism, such as chromosomal truncation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005453> "abolished break-induced loss of heterozygosity via chromosomal translocation")
