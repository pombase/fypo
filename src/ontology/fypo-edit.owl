AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002295> "mitotic catastrophe with cut, elongated cell during cellular response to hydroxyurea during mitotic cell cycle")
