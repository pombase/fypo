# Class: <http://purl.obolibrary.org/obo/FYPO_0005939> (decreased replicative lifespan)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:28139976") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005939> "A cell population phenotype in which the replicative lifespan of a cell population, i.e. the number of divisions cells in the population undergo before death, is lower than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005939> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005939> "2017-02-20T16:04:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005939> "decreased cell population replicative lifespan")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005939> "decreased population replicative lifespan")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005939> "reduced replicative lifespan")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005939> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005939> "FYPO:0005939")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005939> "Although each cell has a replicative lifespan in that it divides a certain number of times and then dies, replicative lifespan is often measured at the population level, where it is defined by the number of generations at which 50% of the starting cells are dead.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005939> "decreased replicative lifespan")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005939> <http://purl.obolibrary.org/obo/FYPO_0000003>)
