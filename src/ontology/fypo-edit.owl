# Class: <http://purl.obolibrary.org/obo/FYPO_0000708> (decreased mating efficiency)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15300681") Annotation(oboInOwl:hasDbXref "PMID:16598689") Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000708> "A biological process phenotype in which the observed mating efficiency, as determined by counting zygotes, asci, and sometimes spores, is lower than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000708> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000708> "2011-12-05T04:26:20Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000708> "reduced mating efficiency")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000708> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "SGD:phenotype_annotation") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000708> "mating efficiency: decreased")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000708> "FYPO:0000708")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000708> "Note that mating efficiency is often measured by counting zygotes plus asci, sometimes also including spores, so a change in measured mating efficiency may reflect a change in conjugation frequency (see FYPO:0000031 and its descendants), a change in sporulation (see FYPO:0000121 and its descendants), or both. For this reason, this term is not a child of 'mating phenotype' (FYPO:0000031).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000708> "decreased mating efficiency")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0000708> <http://purl.obolibrary.org/obo/FYPO_0000003>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0000708> <http://purl.obolibrary.org/obo/FYPO_0001985>)

