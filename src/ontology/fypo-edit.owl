AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002199> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002199> "2013-06-05T11:37:33Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002199> "inviable cell with normal cell morphology during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002199> "inviable vegetative cell with normal cell shape and size")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002199> "lethal; vegetative cell with normal cell morphology")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002199> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002199> "inviable vegetative cell with normal cell morphology during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002199> "FYPO:0002199")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002199> "inviable vegetative cell with normal cell morphology")
