# Class: <http://purl.obolibrary.org/obo/FYPO_0000640> (abnormal chromatin silencing at centromere central core)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000640> "A transcription regulation phenotype observed in the vegetative growth phase of the life cycle in which chromatin silencing is abnormal at the centromere central core. Chromatin silencing is the observed effect of processes that repress transcription at the centromere central core, which is normally assembled into CENP-A-containing chromatin.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000640> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000640> "2011-09-12T03:33:40Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000640> "abnormal centromere central core chromatin silencing")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000640> "abnormal chromatin silencing at centromere central core during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000640> "abnormal chromatin silencing at centromeric central core")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000640> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000640> "abnormal chromatin silencing at centromere central core during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000640> "abnormal negative regulation of transcription at centromere central core")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000640> "abnormal transcriptional repression at centromere central core")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000640> "FYPO:0000640")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000640> "Note that the centromere central core corresponds to SO:0001796. Chromatin silencing phenotypes at the centromere central core may reflect the assembly or maintenance of CENP-A-containing chromatin. See the GO cellular component term 'CENP-A containing chromatin' (GO:0061638), and the biological process term 'CENP-A containing chromatin organization' (GO:0061641).")
