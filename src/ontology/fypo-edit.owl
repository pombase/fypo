AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002158> "response to mitotic G2/M transition DNA damage checkpoint signaling abolished")
