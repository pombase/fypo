AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006909> "mitotic G1/S phase transition at small cell size during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006909> "small cell size at G1/S transition of mitotic cell cycle")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006909> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006909> "FYPO:0006909")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006909> "A G1/S delay may indicate that a checkpoint, such as the cell size checkpoint or the G1/S DNA damage checkpoint, is activated. Checkpoint activation can be tested using checkpoint kinase mutants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006909> "mitotic G1/S phase transition at small cell size")
