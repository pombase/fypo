# Class: <http://purl.obolibrary.org/obo/FYPO_0003823> (septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation during cellular response to hydroxyurea)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003823> "An inviable phenotype observed in the vegetative growth phase of the life cycle in which a cell undergoes septation despite abnormal chromosome segregation, producing inviable daughter cells, and in which the septum forms in a position that partitions both nuclei into one compartment, when a cell is exposed to hydroxyurea. Cell separation may or may not be completed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003823> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003823> "2014-09-15T17:42:18Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003823> "septation following abnormal chromosome segregation, with anucleate cell formation during cellular response to hydroxyurea during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003823> "septation following abnormal chromosome segregation, with binucleate cell formation during cellular response to hydroxyurea")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003823> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003823> "septation following abnormal chromosome segregation, with anucleate cell formation during cellular response to hydroxyurea during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003823> "FYPO:0003823")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003823> "In cells with this phenotype, septation has proceeded despite chromosome segregation failing to complete normally. Chromosome segregation may be incomplete or entirely abolished. Consider also annotating to 'cut' (FYPO:0003155) or its descendants, because these phenotypes often co-occur.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003823> "septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation during cellular response to hydroxyurea")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003823> <http://purl.obolibrary.org/obo/FYPO_0003166>)

