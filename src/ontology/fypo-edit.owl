# Class: <http://purl.obolibrary.org/obo/FYPO_0003120> (decreased transcription during glucose starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003120> "A cellular process phenotype in which transcription occurs to a lower extent than normal when the cell is subject to glucose starvation. All genes, or a specific subset of genes, may be affected.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003120> "midori")
