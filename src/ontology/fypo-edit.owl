# Class: <http://purl.obolibrary.org/obo/FYPO_0005512> (increased activation of meiosis I spindle assembly checkpoint)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:26483559") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005512> "A cell cycle checkpoint phenotype in which the meiosis I spindle assembly checkpoint is activated more frequently than normal, typically under conditions that do not cause checkpoint activation in wild-type cells. The meiosis I spindle assembly checkpoint normally delays the metaphase/anaphase transition of the first meiotic nuclear division until the spindle is correctly assembled and chromosomes are attached to the spindle.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005512> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005512> "2016-07-13T13:50:44Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005512> "increased activation of first meiotic nuclear division spindle assembly checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005512> "increased activation of meiosis I cell cycle spindle assembly checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005512> "increased activation of spindle assembly checkpoint during meiosis I")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005512> "increased meiosis I spindle assembly checkpoint activation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005512> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005512> "FYPO:0005512")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005512> "Checkpoint activation in a mutant usually implies that the mutation is causing problems that the checkpoint detects.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005512> "increased activation of meiosis I spindle assembly checkpoint")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0005512> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0002051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0090687>))))
