AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003548> "abolished mitotic G1/S transition following nitrogen starvation-induced G1 phase arrest")
