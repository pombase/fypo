# Class: <http://purl.obolibrary.org/obo/FYPO_0005664> (viable elongated cell during nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:12399381") Annotation(oboInOwl:hasDbXref "PMID:19366728") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005664> "A cell morphology phenotype in which a cell is viable, and becomes elongated, i.e. has a greater length and length:diameter ratio than normal, when the cell is subject to nitrogen starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005664> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005664> "2016-09-13T12:05:33Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005664> "cdr phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005664> "viable elongated cell during nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005664> "viable elongated cell during nitrogen deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005664> "viable long cell during nitrogen starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005664> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005664> "FYPO:0005664")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005664> "Note that wild-type cells become shorter under nitrogen starvation conditions than under nitrogen-replete conditions, and that mutant cells subjected to nitrogen starvation may have lengths similar to wild type cells under non-starved conditions. Also note that this term is classified as a type of abnormal cell shape, because under a given set of conditions wild-type cells are never seen with the proportions (length:diameter ratio) observed in elongated cells. Small cells, in contrast, have the same proportions as a subset of wild-type cells, and simply do not grow to the full length seen in wild type. This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005664> "viable elongated cell during nitrogen starvation")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0005664> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FYPO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000124>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0000998>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0006995>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0000521>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005664> <http://purl.obolibrary.org/obo/FYPO_0000002>)

