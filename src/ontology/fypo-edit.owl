AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004593> "abnormal vegetative cell phenotype following normal mitosis and passage through mitotic G1 phase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0140014") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004593> "abnormal vegetative cell phenotype following normal mitotic nuclear division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004593> "abnormal vegetative cell phenotype following normal nuclear division during mitotic cell cycle")
