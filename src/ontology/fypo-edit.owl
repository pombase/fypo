# Class: <http://purl.obolibrary.org/obo/FYPO_0000025> (swollen cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000025> "A cell morphology phenotype in which a cell has a larger volume than normal. In a swollen cell, both length and diameter are greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000025> "midori")
