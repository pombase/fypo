# Class: <http://purl.obolibrary.org/obo/FYPO_0004593> (abnormal vegetative cell phenotype following normal mitosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004593> "A phenotype that shows detectable differences from normal at the level of an individual cell, when the cell is in the vegetative growth phase of the cell cycle, and after it has undergone a normal mitotic nuclear division and passed through the subsequent mitotic interphase.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004593> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004593> "2015-04-29T15:59:40Z")
