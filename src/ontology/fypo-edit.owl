# Class: <http://purl.obolibrary.org/obo/FYPO_0007243> (normal NETO in cell derived from growing end and premature NETO in cell derived from non-growing end)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:31719163") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007243> "A cell polarity phenotype in which the switch from the monopolar to bipolar mode of cell growth (new end take-off; NETO) is normal (i.e. indistinguishable from wild type) in one, and premature in the other, of the daughter cells formed as a result of the division of a mother cell in which NETO did not occurs. NETO is normal in the daughter cell that inherits the parent cell's old end, and begins earlier than normal in the daughter cell that inherits parent cell's new end. Normally, growth begins at the old end and then becomes bipolar with similar timing in both daughter cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0007243> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0007243> "2020-02-11T14:53:32Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007243> "normal NETO in cell derived from growing end and premature NETO in cell derived from non-growing end during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0051523") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007243> "normal cell growth mode switching, monopolar to bipolar in cell derived from growing end and premature cell growth mode switching, monopolar to bipolar in cell derived from non-growing end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007243> "normal new end take-off in cell derived from growing end and premature NETO in cell derived from non-growing end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007243> "normal switch from monopolar to bipolar cell growth in cell derived from growing end and premature switch from monopolar to bipolar cell growth in cell derived from non-growing end")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007243> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007243> "normal NETO in cell derived from growing end and premature NETO in cell derived from non-growing end during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007243> "normal activation of bipolar cell growth in cell derived from growing end and premature activation of bipolar cell growth in cell derived from non-growing end")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007243> "FYPO:0007243")
