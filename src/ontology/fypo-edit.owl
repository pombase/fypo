AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006822> "mitosis with small cell size and normal cell growth rate")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006822> "reduced size at cell division with normal cell growth rate")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006822> "viable small vegetative cell with normal cell growth rate during mitotic cell cycle")
