AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002299> "OBSOLETE. A mixed population phenotype in which all cells in a population are inviable germinated spores with curved germ tubes, and in which some cells divide once and others do not divide. In the cells that divide once, an inviable cell forms from the growing end of the germ tube, but does not divide further.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002299> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002299> "2013-06-20T11:44:24Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002299> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002299> "FYPO:0002299")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002299> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002299> "obsolete inviable mixed population including divided and undivided germinated spores, with curved germ tubes")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002299> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002300> (obsolete inviable mixed population including germinated spores with elongated germ tubes and elongated cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002300> "OBSOLETE. A mixed population phenotype in which all cells in a population are inviable, and the population includes a mixture of germinated spores with elongated germ tubes and elongated vegetative cells. The elongated cells arise from division of some of the germinated spores, and may form a microcolony of up to 64 cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002300> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002300> "2013-06-20T11:57:57Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002300> "inviable mixed population including germinated spores with elongated germ tubes and long cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002300> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002300> "FYPO:0002300")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002300> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002300> "obsolete inviable mixed population including germinated spores with elongated germ tubes and elongated cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002300> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002301> (obsolete inviable microcolony, curved septated cells)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002301> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells that are curved along the long axis and contain one or more septa. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002301> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002301> "2013-06-20T13:28:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002301> "inviable microcolony, curved septated vegetative cells")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002301> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002301> "FYPO:0002301")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002301> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002301> "obsolete inviable microcolony, curved septated cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002301> "true"^^xsd:boolean)

