AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0031619") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003177> "abnormal homologous chromosome orientation involved in meiotic metaphase I plate congression")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003177> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003177> "FYPO:0003177")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003177> "abnormal meiotic homologous chromosome biorientation")
