# Class: <http://purl.obolibrary.org/obo/FYPO_0004800> (abolished premeiotic DNA replication during azygotic meiotic cell cycle)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22558440") Annotation(oboInOwl:hasDbXref "PMID:25891897") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004800> "A cellular process phenotype in which premeiotic DNA replication does not occur during a cycle of azygotic meiosis and sporulation. Azygotic meiosis and sporulation occur when meiosis takes place within a diploid cell rather than in a zygote produced by sporulation. Zygotes can resume vegetative growth and form colonies of diploid cells if returned to rich media before commitment to meiosis; under nitrogen starvation, diploid cells heterozygous for mating type will undergo azygotic meiosis. Azygotic asci have a characteristic linear morphology resembling that of a single vegetatively growing cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004800> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004800> "2015-08-07T12:03:30Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004800> "abolished DNA replication before azygotic meiotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004800> "abolished premeiotic DNA replication during azygotic meiosis and sporulation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004800> "absent premeiotic DNA replication during azygotic meiotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004800> "premeiotic DNA replication abolished during azygotic meiotic cell cycle")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004800> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004800> "abolished premeiotic DNA replication during azygotic meiosis")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004800> "FYPO:0004800")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004800> "abolished premeiotic DNA replication during azygotic meiotic cell cycle")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004800> <http://purl.obolibrary.org/obo/FYPO_0002044>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004801> (delayed onset of premeiotic DNA replication during azygotic meiosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22558440") Annotation(oboInOwl:hasDbXref "PMID:25891897") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004801> "A cellular process phenotype in which premeiotic DNA replication begins later than normal during a cycle of azygotic meiosis and sporulation. Azygotic meiosis and sporulation occur when meiosis takes place within a diploid cell rather than in a zygote produced by sporulation. Zygotes can resume vegetative growth and form colonies of diploid cells if returned to rich media before commitment to meiosis; under nitrogen starvation, diploid cells heterozygous for mating type will undergo azygotic meiosis. Azygotic asci have a characteristic linear morphology resembling that of a single vegetatively growing cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004801> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004801> "2015-08-07T12:06:12Z")
