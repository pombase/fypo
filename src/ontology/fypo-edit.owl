AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003160> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003160> "2014-02-26T17:30:37Z")
