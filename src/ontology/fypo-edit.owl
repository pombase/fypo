# Class: <http://purl.obolibrary.org/obo/FYPO_0001142> (normal Man8GlcNAc level)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "CHEBI:64048") Annotation(oboInOwl:hasDbXref "CHEBI:64052") Annotation(oboInOwl:hasDbXref "PMID:12686557") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001142> "A cell phenotype observed in the vegetative growth phase of the life cycle in which the amount of Man8GlcNAc2 measured in a cell is normal (i.e. indistinguishable from wild type). Man8GlcNAc2 is any N-glycan that consists of a branched ten-membered mannooligosaccharide containing eight D-mannosyl residues and two N-acetylglucosamine residues.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001142> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001142> "2012-06-14T15:52:46Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001142> "normal Man8GlcNAc level during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001142> "normal Man8GlcNAc2 level")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001142> "normal cellular Man8GlcNAc level")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001142> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001142> "normal Man8GlcNAc accumulation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001142> "normal Man8GlcNAc level during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001142> "FYPO:0001142")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001142> "Note that these terms treat Man(n)GlcNAc and Man(n)GlcNAc2 as equivalent. The reason is that the GlcNAc2 form is attached to N-linked glycoproteins, but the GlcNAc form is what is usually detected in experiments, following cleavage by endoglycosidase H. For the purposes of observing and interpreting phenotypes, the difference is not significant.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001142> "normal Man8GlcNAc level")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001142> <http://purl.obolibrary.org/obo/FYPO_0001077>)

