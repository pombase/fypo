AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002181> "FYPO:0002181")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002181> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002181> "obsolete inviable mixed population including germinated spores and spheroid cells")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002181> "true"^^xsd:boolean)

