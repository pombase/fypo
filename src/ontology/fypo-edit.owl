AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005826> "decreased level of generation of precursor metabolites and energy RNA during mitotic cell cycle")
