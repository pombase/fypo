AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005369> "A vegetative cell population growth phenotype in which a cell population does not grow at low temperatures.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005369> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005369> "2016-04-12T13:58:16Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "abolished growth at low temperature")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "abolished vegetative cell population growth at low temperature")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "cell population growth at low temperature abolished")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005369> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "abolished cell population growth at low temperature during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "cold sensitive")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "hypersensitive to low temperature")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "sensitive to cold")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "sensitive to low temperature")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "sensitive to low temperature during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005369> "temperature sensitive")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005369> "FYPO:0005369")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005369> "For fission yeast, low temperature usually corresponds to below 25 degrees Celsius. Use this term for a population of cells that does not grow at low temperature, but does grow at a higher temperature (a cell population that does not grow at any temperature would be considered inviable). Note that cell growth terms refer to growth under aerobic conditions unless stated otherwise.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005369> "abolished cell population growth at low temperature")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005369> <http://purl.obolibrary.org/obo/FYPO_0001575>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0005370> (decreased fidelity of double-strand break repair via nonhomologous end joining)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:11226171") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005370> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which occurrence of errors, usually small deletions, upon repair of double-strand breaks in DNA by nonhomologous end joining is increased.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005370> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005370> "2016-04-18T14:05:24Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005370> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005370> "FYPO:0005370")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005370> "In wild type S. pombe cells, errors occur in 40-60% of NHEJ-mediated DSB repair events. In mutants with this phenotype, few or no repairs may be free of errors.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005370> "decreased fidelity of double-strand break repair via nonhomologous end joining")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005370> <http://purl.obolibrary.org/obo/FYPO_0003661>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0005371> (increased linear minichromosome loss during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:11226171") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005371> "A cell phenotype in which linear minichromosomes are lost at a higher frequency than normal during the vegetative growth phase of the life cycle. Minichromosome loss occurs when one or both daughter cells do not inherit copies of a minichromosome from the mother cell, and may result from failure of minichromosome replication or segregation.")
