# Class: <http://purl.obolibrary.org/obo/FYPO_0007689> (normal cell growth polarization)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21148300") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007689> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which cells can grow in a normally (i.e. as in wild type) polarized manner as in the presence of a polarity landmark. The landmark itself may be in a normal or abnormal location.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007689> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007689> "2021-03-23T14:16:39Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007689> "normal cell growth polarisation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007689> "normal cell growth polarization during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007689> "normal vegetative cell growth polarization")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007689> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007689> "normal cell growth polarization during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007689> "FYPO:0007689")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0007689> "The difference between this term and 'normal cell polarity' (FYPO:0005456) is that this term can be used if a polarity landmark is in an abnormal place, but polar growth takes place at the landmark. FYPO:0005465 can be used only when all aspects of polar growth are normal.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007689> "normal cell growth polarization")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007689> <http://purl.obolibrary.org/obo/FYPO_0001319>)

