AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002158> "abolished mitotic G2/M transition DNA damage checkpoint arrest")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002158> "FYPO:0002158")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002158> "May indicate that a cell cycle checkpoint is not activated under conditions that normally trigger checkpoint signaling and subsequent cell cycle arrest.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002158> "abolished response to mitotic G2/M transition DNA damage checkpoint signaling")
