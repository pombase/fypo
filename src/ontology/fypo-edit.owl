# Class: <http://purl.obolibrary.org/obo/FYPO_0001210> (Glc2Man9GlcNAc absent from cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "CHEBI:59082") Annotation(oboInOwl:hasDbXref "PMID:9813085") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001210> "A cell phenotype observed in the vegetative growth phase of the life cycle in which the amount of Glc2Man9GlcNAc2 measured in a cell is too low to detect. Glc2Man9GlcNAc2 is an N-glycan that is involved in post-translational modification of proteins, and consists of a branched ten-membered mannooligosaccharide containing two D-glucose residues, nine D-mannosyl residues and two N-acetylglucosamine residues.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001210> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001210> "2012-07-12T12:13:39Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001210> "Glc2Man9GlcNAc absent from cell during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001210> "Glc2Man9GlcNAc2 absent from cell")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001210> "absent Glc2Man9GlcNAc")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001210> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001210> "Glc2Man9GlcNAc absent from cell during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001210> "FYPO:0001210")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001210> "Note that these terms treat Man(n)GlcNAc and Man(n)GlcNAc2 as equivalent. The reason is that the GlcNAc2 form is attached to N-linked glycoproteins, but the GlcNAc form is what is usually detected in experiments, following cleavage by endoglycosidase H. For the purposes of observing and interpreting phenotypes, the difference is not significant.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001210> "Glc2Man9GlcNAc absent from cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0001210> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0002000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000002> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0000334>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002503> <http://purl.obolibrary.org/obo/CHEBI_59082>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001210> <http://purl.obolibrary.org/obo/FYPO_0001209>)

