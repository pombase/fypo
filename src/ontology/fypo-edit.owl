# Class: <http://purl.obolibrary.org/obo/FYPO_0005231> (loss of viability in stationary phase upon glucose starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:26624998") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005231> "A cell population phenotype in which a smaller than normal proportion of cells in the population remains viable after entering stationary phase, when cells the population are subject to glucose starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005231> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005231> "2016-02-02T12:20:17Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005231> "decreased viability in stationary phase upon glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005231> "loss of cell population viability in stationary phase upon glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005231> "loss of viability in stationary phase during glucose starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005231> "reduced viability in stationary phase upon glucose starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005231> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005231> "growth defect, required for stationary phase upon glucose starvation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005231> "FYPO:0005231")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005231> "Use this term to annotate experiments in which a culture is grown to stationary phase, and then the number of cells viable enough to form a colony upon return to conditions supporting vegetative growth is measured and compared to wild type. Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005231> "loss of viability in stationary phase upon glucose starvation")
