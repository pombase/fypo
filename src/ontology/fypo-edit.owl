# Class: <http://purl.obolibrary.org/obo/FYPO_0003979> (abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell with 1C DNA content per nucleus)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:8313905") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003979> "A cellular process phenotype in which progression through the mitotic cell cycle is arrested when cells have condensed chromosomes, a single, normally located septum, and 1C DNA content in each nucleus, under conditions where arrest does not normally occur.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003979> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003979> "2014-11-04T16:04:34Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003979> "abnormal cell cycle arrest with condensed chromosomes, septated cell with 1C DNA content per nucleus during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003979> "abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell with 1C DNA content per nucleus during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003979> "abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell with 1C nuclei")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003979> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003979> "FYPO:0003979")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003979> "This phenotype arises when a cell fails to exit mitosis correctly, such that chromosomes remain condensed and cytokinesis is not completed. In wild-type cells, chromosomes are condensed only in M phase. This term can be used for mutants in which chromosomes are condensed but other normal features of M phase cells are not observed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003979> "abnormal mitotic cell cycle arrest with condensed chromosomes, septated cell with 1C DNA content per nucleus")
