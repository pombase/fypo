SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005334> <http://purl.obolibrary.org/obo/FYPO_0004639>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0005335> (abnormal cell cycle arrest at mitotic G2/M phase transition during glucose starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:26804466") Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005335> "A cellular process phenotype in which progression through mitotic cell cycle arrest at the mitotic G2/M phase transition occurs abnormally when the cell is subject to glucose starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005335> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005335> "2016-04-04T12:44:23Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005335> "abnormal cell cycle arrest at mitotic G2/M phase transition during glucose deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005335> "abnormal cell cycle arrest in mitotic G2 phase during glucose depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005335> "abnormal mitotic cell cycle arrest at mitotic G2/M phase transition during glucose starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005335> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005335> "abnormal cell cycle arrest at mitotic G2/M phase transition during glucose limitation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005335> "abolished mitotic G2/M phase transition during glucose starvation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005335> "FYPO:0005335")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005335> "Cells normally arrest the mitotic cell cycle at the mitotic G2/M phase transition when subject to glucose starvation. Use this term if the G2 arrest does not occur exactly as in wild type cells. Note that FYPO uses \"glucose starvation\" to refer specifically to conditions in which glucose is scarce enough to trigger mating, meiosis, and sporulation. For phenotypes observed in the presence of enough glucose to prevent cells from mating, use a term that specifies \"during vegetative growth\" plus a condition to indicate low glucose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005335> "abnormal cell cycle arrest at mitotic G2/M phase transition during glucose starvation")
