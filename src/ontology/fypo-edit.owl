AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006736> "stationary phase viability unaffected by TMN")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006736> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006736> "chronological lifespan unaffected by tschimganine")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006736> "loss of chronological lifespan extension by tschimganine")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006736> "FYPO:0006736")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006736> "Although each cell has a replicative lifespan in that it divides a certain number of times and then dies, replicative lifespan is often measured at the population level, where it is defined by the number of generations at which 50% of the starting cells are dead.")
