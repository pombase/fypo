# Class: <http://purl.obolibrary.org/obo/FYPO_0002156> (binucleate monoseptate cell, with angled septum)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002156> "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which a cell has two nuclei and one septum, and in which the septum is located between the two nuclei but is not perpendicular to the long axis of the cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002156> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002156> "2013-05-10T15:43:47Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002156> "binucleate monoseptate cell, with angled septum, during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002156> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002156> "binucleate monoseptate cell, with angled septum during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002156> "binucleate monoseptate cell, with septum not orthogonal to long axis")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002156> "FYPO:0002156")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002156> "Note that a cell that has the phenotype 'angled actomyosin contractile ring' (FYPO:0002027) will usually also subsequently display this phenotype. When using this term, also consider annotating to a cell cycle arrest term, such as 'abnormal cell cycle arrest in mitotic telophase' (FYPO:0000622); 'abnormal cell cycle arrest in mitotic anaphase' (FYPO:0000619) may be applicable if the assay detects DNA masses. Binucleate cells often arise as a result of cell cycle arrest.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002156> "binucleate monoseptate cell, with angled septum")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002156> <http://purl.obolibrary.org/obo/FYPO_0001222>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002156> <http://purl.obolibrary.org/obo/FYPO_0001390>)

