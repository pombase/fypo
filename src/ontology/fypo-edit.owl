# Class: <http://purl.obolibrary.org/obo/FYPO_0003252> (abolished cell population growth on proline nitrogen source)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003252> "A vegetative cell population growth phenotype in which a cell population does not grow in a medium containing L-proline as the nitrogen source.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003252> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003252> "2014-04-01T11:30:43Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0003252> "abolished growth on proline nitrogen source")
