# Class: <http://purl.obolibrary.org/obo/FYPO_0002046> (resistance to stress)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002046> "A phenotype in which cells in a population show decreased sensitivity to a stress. Typically, a cell population is deemed resistant to a stress if cells in the population grow and divide when exposed to the stress at an intensity at which wild-type cells stop growing (and may die).")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002046> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002046> "2013-03-14T15:56:42Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002046> "increased cell population growth during cellular response to stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002046> "increased growth during cellular response to stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002046> "resistant to stress")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002046> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "SGD:phenotype_annotation") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002046> "stress resistance: increased")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002046> "FYPO:0002046")
AnnotationAssertion(oboInOwl:inSubset <http://purl.obolibrary.org/obo/FYPO_0002046> <http://purl.obolibrary.org/obo/fypo#qc_do_not_manually_annotate>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002046> "This is a high-level term whose primary purpose is to organize terms beneath it in the ontology, and we expect that it will not be used for direct annotations. Please consider using a more specific term to annotate each phenotype. Use a descendant of this term if you have assayed growth of cells exposed to a stress in culture. If you have assayed the response to the stress at the subcellular or molecular level, consider annotating to a descendant of 'abnormal cellular response to stress' (FYPO:0000162).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002046> "resistance to stress")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002046> <http://purl.obolibrary.org/obo/FYPO_0000045>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002047> (resistance to heat shock during nitrogen starvation)

