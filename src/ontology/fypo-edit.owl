AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006636> "FYPO:0006636")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006636> "This term can be used for protein that do not normally localize to discrete cytoplasmic regions, or for proteins that do normally show punctate localization but with such localization increased in a mutant. We recommend noting which protein(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006636> "mislocalized protein distributed in cell cortex")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0006636> <http://purl.obolibrary.org/obo/FYPO_0000782>)

