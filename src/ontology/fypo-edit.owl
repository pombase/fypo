AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006899> "asymmetric cell separation after cytokinesis during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006899> "FYPO:0006899")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006899> "This phenotype usually results from a defect late in septum degradation.")
