# Class: <http://purl.obolibrary.org/obo/FYPO_0003166> (monoseptate vegetative cell with binucleate and anucleate compartments)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003166> "A cell phenotype observed in the vegetative growth phase of the life cycle in which a cell has two nuclei and one septum, but both nuclei are in a single compartment on one side of the septum. Arises when a cell undergoes septation despite abnormal chromosome segregation, producing inviable daughter cells, and in which the septum forms in a position that partitions both nuclei into one compartment. Cell separation may or may not be completed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003166> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003166> "2014-03-05T11:09:42Z")
AnnotationAssertion(oboInOwl:hasAlternativeId <http://purl.obolibrary.org/obo/FYPO_0003166> "FYPO:0004699")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "monoseptate cell with binucleate and anucleate compartments during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "monoseptate vegetative cell with binucleate and anucleate compartments following abnormal chromosome segregation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "septation following abnormal chromosome segregation, with binucleate and anucleate compartment formation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "septation following abnormal chromosome segregation, with binucleate cell formation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003166> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "abnormal nuclear segregation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "binucleate monoseptate cell with nuclei grouped")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "monoseptate vegetative cell with binucleate and anucleate compartments during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "nuclear missegregation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003166> "unequal nuclear partitioning")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003166> "FYPO:0003166")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003166> "In cells with this phenotype, septation has proceeded despite chromosome segregation failing to complete normally. Chromosome segregation may be incomplete or entirely abolished. Consider also annotating to 'cut' (FYPO:0003155) or its descendants, because these phenotypes often co-occur. Consider also annotating to 'unequal mitotic sister chromatid segregation' (FYPO:0003241) or one of its descendants, because the abnormal chromosome segregation seen in these mutants often separates DNA into unequal portions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003166> "monoseptate vegetative cell with binucleate and anucleate compartments")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003166> <http://purl.obolibrary.org/obo/FYPO_0000002>)
