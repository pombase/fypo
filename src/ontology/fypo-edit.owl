# Class: <http://purl.obolibrary.org/obo/FYPO_0006690> (obsolete mitotic catastrophe with abnormal chromosome segregation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006690> "OBSOLETE. A cell phenotype observed in the vegetative growth phase of the life cycle in which a cell proceeds through the mitotic metaphase/anaphase transition in the presence of an uncorrected problem (such as chromosome structure or kinetochore attachment), and as a result undergoes abnormal chromosome segregation and subsequently dies.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006690> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006690> "2018-10-16T13:32:39Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006690> "mitotic catastrophe with abnormal chromosome segregation during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006690> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006690> "mitotic catastrophe with abnormal chromosome segregation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006690> "FYPO:0006690")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006690> "This term was made obsolete because \"mitotic catastrophe\" has not been clearly defined for fission yeast.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006690> "obsolete mitotic catastrophe with abnormal chromosome segregation")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0006690> "true"^^xsd:boolean)

