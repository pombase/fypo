AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003211> "abnormal secondary cell septum biogenesis during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003211> "abnormal secondary cell septum formation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003211> "abnormal secondary cell septum synthesis")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003211> "FYPO:0003211")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003211> "Consider also annotating to 'abnormal contractile ring localization' (FYPO:0000033) because if the contractile ring forms in an abnormal location, the septum will also do so. The positions of both the contractile ring and the septum are determined by the processes that select the site of cell division.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003211> "abnormal secondary cell septum biogenesis")
