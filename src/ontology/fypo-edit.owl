# Class: <http://purl.obolibrary.org/obo/FYPO_0004694> (fragmented DNA during stationary phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:12963726") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004694> "A cell phenotype in which DNA is broken into small fragments when the population in which the cell is found is in stationary phase.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004694> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004694> "2015-06-12T13:45:52Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004694> "DNA fragmentation during stationary phase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004694> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004694> "fragmented nucleus during stationary phase")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004694> "FYPO:0004694")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004694> "This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. Use 'fragmented DNA' (FYPO:0000160) or one of its descendants if DNA was detected using a method that can resolve molecule sizes (e.g. gel electrophoresis) or detect DNA ends (e.g. TUNEL assay). Otherwise, consider using 'fragmented nucleus' (FYPO:0001919) or one of its descendants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004694> "fragmented DNA during stationary phase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004694> <http://purl.obolibrary.org/obo/FYPO_0000160>)

