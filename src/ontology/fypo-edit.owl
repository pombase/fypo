AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasBroadSynonym <http://purl.obolibrary.org/obo/FYPO_0000173> "abnormal DNA replication checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000173> "abnormal mitotic cell cycle DNA replication checkpoint activation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000173> "fission_yeast_phenotype")
