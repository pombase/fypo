# Class: <http://purl.obolibrary.org/obo/FYPO_0007391> (inviable aneuploid spore)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22737087") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007391> "A viability phenotype in which an aneuploid spore is unable to survive under conditions in which wild type spores survive. An inviable spore does not germinate.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007391> "midori")
