AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005780> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005780> "FYPO:0005780")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005780> "decreased response to mitotic spindle assembly checkpoint signaling")
