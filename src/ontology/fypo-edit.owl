# Class: <http://purl.obolibrary.org/obo/FYPO_0002516> (premature mitotic G2/M phase transition)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000086") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002516> "A cell cycle phenotype in which the G2/M transition of the mitotic cell cycle begins earlier than normal. The duration of G2 phase is thus shorter than normal. The mitotic G2/M transition is the point at which a cell commits to entering M phase, and begins when the kinase activity of M cyclin/CDK complex reaches a threshold high enough for the cell cycle to proceed.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002516> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002516> "2013-08-15T14:12:36Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "advanced mitotic G2/M transition")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "mitotic G2/M transition advance")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "mitotic G2/M transition advance during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "mitotic cell cycle advance at G2/M transition")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "premature G2/M phase transition during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "premature cell cycle progression through mitotic G2/M phase transition")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "premature mitotic G2/M phase transition during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "premature mitotic G2/M transition")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002516> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "advanced mitotic G2 phase progression")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "cell cycle, mitotic G2 advance")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "decreased duration of mitotic G2 phase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "decreased duration of mitotic G2 phase during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "decreased mitotic G2 duration")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "increased rate of mitotic G2 phase progression")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002516> "mitotic G2 advance")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002516> "FYPO:0002516")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002516> "Use this term if you have measured CDK activity or calculated the transition point to detect the transition; otherwise, consider using 'premature mitosis' (FYPO:0001046). A G2/M advance may indicate that a checkpoint, such as the DNA replication checkpoint or the G2/M DNA damage checkpoint, is impaired. Checkpoint activation can be tested using checkpoint kinase mutants.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002516> "premature mitotic G2/M phase transition")
