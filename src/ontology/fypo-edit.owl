# Class: <http://purl.obolibrary.org/obo/FYPO_0005440> (swollen elongated cell with enlarged nucleus)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:12653962") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005440> "A cell morphology phenotype in which a vegetative cell is swollen, is elongated, and in which the nucleus is larger than normal. The cell contains one nucleus and no septum. In a swollen cell, both length and diameter may be greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005440> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005440> "2016-06-15T13:34:38Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005440> "elongated cell with enlarged nucleus and increased cell volume")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005440> "swollen elongated mononucleate aseptate cell with enlarged nucleus")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005440> "swollen elongated vegetative cell with enlarged nucleus")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005440> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005440> "enlarged elongated cell with enlarged nucleus")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005440> "large elongated cell with enlarged nucleus")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005440> "FYPO:0005440")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005440> "The distinction between this phenotype and centrally constricted (dumbbell-shaped) cells (FYPO:0000779) is that swollen elongated cells do not have a constriction along the long axis. Swollen elongated cells may have a uniform diameter, or may be swollen only around the nucleus. This phenotype is usually seen in diploid cells, so consider also annotating to 'increased spontaneous diploidization' (FYPO:0000252).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005440> "swollen elongated cell with enlarged nucleus")
