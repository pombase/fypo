# Class: <http://purl.obolibrary.org/obo/FYPO_0004536> (abnormal response to mitotic cell cycle spindle assembly checkpoint signaling)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004536> "A cellular process phenotype in which a mitotic cell cycle arrest that normally occurs in response to mitotic cell cycle spindle assembly checkpoint signaling is abnormal (does not occur, or occurs abnormally). Abnormal arrest may result from a problem with detection of conditions that normally trigger a checkpoint, transduction of the checkpoint signal, or the response to the checkpoint signal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004536> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004536> "2015-04-02T14:00:45Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004536> "abnormal response to mitotic spindle assembly checkpoint signaling")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004536> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004536> "abnormal mitotic cell cycle spindle assembly checkpoint arrest")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004536> "abnormal occurrence of mitotic cell cycle arrest resulting from spindle assembly checkpoint activation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004536> "abnormal occurrence of mitotic cell cycle arrest resulting from spindle assembly defective checkpoint activation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004536> "FYPO:0004536")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004536> "abnormal response to mitotic cell cycle spindle assembly checkpoint signaling")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0004536> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0072476>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004536> <http://purl.obolibrary.org/obo/FYPO_0002517>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004537> (mitotic spindle assembly checkpoint override)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:11952833") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004537> "A cellular process phenotype in which a mitotic cell cycle arrest that normally occurs in response to mitotic cell cycle spindle assembly checkpoint signaling does not occur. As a result, the septation initiation network (SIN) signaling pathway is activated despite activation of the mitotic spindle assembly checkpoint (SAC). Normally, under conditions that activate the SAC, SIN activation is inhibited and the cell cycle arrests in anaphase. In this phenotype, premature SIN activation leads to premature cytokinesis and the formation of cut cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004537> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004537> "2015-04-02T14:10:40Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004537> "SIN activation in presence of active mitotic SAC")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004537> "abolished response to mitotic cell cycle spindle assembly checkpoint signaling")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004537> "mitotic SAC override")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004537> "mitotic cell cycle spindle assembly checkpoint override")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004537> "septation initiation signaling activation in presence of active mitotic spindle assembly checkpoint")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004537> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004537> "FYPO:0004537")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004537> "mitotic spindle assembly checkpoint override")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0004537> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001558> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000002> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0072476>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004537> <http://purl.obolibrary.org/obo/FYPO_0004536>)
