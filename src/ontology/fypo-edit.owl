# Class: <http://purl.obolibrary.org/obo/FYPO_0000168> (abnormal mitotic spindle assembly checkpoint)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0007094") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000168> "A cell cycle checkpoint phenotype in which the spindle assembly checkpoint of a mitotic cell cycle is abnormal. The mitotic spindle assembly checkpoint normally delays the metaphase/anaphase transition of a mitotic nuclear division until the spindle is correctly assembled and chromosomes are attached to the spindle. In a mutant, the checkpoint may fail to arrest or delay cell cycle progression under appropriate conditions, or the incidence or duration of arrest or delay may differ from wild type under any specified set of conditions.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000168> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000168> "2011-04-13T03:34:54Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000168> "abnormal mitotic cell cycle spindle assembly checkpoint")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000168> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000168> "abnormal mitotic spindle assembly checkpoint activation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000168> "FYPO:0000168")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000168> "abnormal mitotic spindle assembly checkpoint")
