AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005371> "increased linear minichromosome loss during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005371> "mitotic linear minichromosome maintenance defect")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005371> "FYPO:0005371")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005371> "increased linear minichromosome loss during vegetative growth")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005371> <http://purl.obolibrary.org/obo/FYPO_0001320>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005371> <http://purl.obolibrary.org/obo/FYPO_0001840>)

