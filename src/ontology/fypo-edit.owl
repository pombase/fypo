AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001152> "A cell phenotype in which the amount of RNA measured in a cell when the cell is subject to nitrogen starvation is lower than normal. Total RNA or a specific RNA may be affected.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001152> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001152> "2012-06-14T16:52:51Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001152> "decreased RNA level during nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001152> "decreased RNA level during nitrogen deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001152> "decreased transcript level during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001152> "reduced RNA level during nitrogen starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001152> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001152> "decreased RNA accumulation during nitrogen starvation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001152> "FYPO:0001152")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001152> "Consider annotating to a term describing abnormal transcription or abnormal regulation of transcription, but note that changes in RNA levels may result from changes in RNA stability as well as changes in transcription. This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. We recommend noting which RNA(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001152> "decreased RNA level during nitrogen starvation")
