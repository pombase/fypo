AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001227> "protein mislocalized to cytoplasm in response to hydrogen peroxide")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001227> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0001227> "protein mislocalized to cytoplasm during cellular response to hydrogen peroxide during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001227> "FYPO:0001227")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001227> "Note that this term can be used to annotate any case where a protein is found in the cytoplasm in a mutant, but not in wild type. In some cases, there may be enough additional information to annotate to 'abnormal protein localization' (FYPO:0000443) or one of its descendants. We recommend noting which protein(s) were used in the assay when annotating to this term.")
