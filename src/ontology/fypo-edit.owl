# Class: <http://purl.obolibrary.org/obo/FYPO_0004760> (abnormal sporulation resulting in formation of azygotic ascus with more than four spores)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004760> "A sporulation phenotype in which azygotic asci that contain more than four, and up to eight, spores form following conjugation, diploid growth, and subsequent azygotic sporulation. Azygotic ascus formation occurs when meiosis takes place within a diploid cell rather than in a zygote produced by sporulation. Zygotes can resume vegetative growth and form colonies of diploid cells if returned to rich media before commitment to meiosis; under nitrogen starvation, diploid cells heterozygous for mating type will undergo azygotic meiosis. Azygotic asci have a characteristic linear morphology resembling that of a single vegetatively growing cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004760> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004760> "2015-07-28T14:26:07Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0030437") Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004760> "abnormal azygotic ascospore formation resulting in formation of asci with more than four spores")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004760> "abnormal sporulation resulting in formation of azygotic asci with more than four spores")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004760> "azygotic asci with increased number of spores")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004760> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004760> "8-spored azygotic asci")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004760> "eight-spored azygotic asci")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004760> "FYPO:0004760")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004760> "abnormal sporulation resulting in formation of azygotic ascus with more than four spores")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004760> <http://purl.obolibrary.org/obo/FYPO_0001893>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004760> <http://purl.obolibrary.org/obo/FYPO_0003263>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004761> (increased histone exchange at pericentric heterochromatin)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0005721") Annotation(oboInOwl:hasDbXref "GO:0043486") Annotation(oboInOwl:hasDbXref "PMID:24095277") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004761> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which histone exchange occurs to a greater extent than normal in regions of pericentric heterochromatin. Histone exchange is replacement, within chromatin, of resident histones or histone subunits with alternative, sometimes variant, histones or subunits.")
