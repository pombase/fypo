# Class: <http://purl.obolibrary.org/obo/FYPO_0000023> (small cell)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0000023> "A cell morphology phenotype in which a cell has an abnormally low volume.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0000023> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0000023> "2011-03-29T05:53:56Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000023> "decreased cell size")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0000023> "reduced cell size")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0000023> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "SGD:phenotype_annotation") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0000023> "cell size: decreased")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000023> "FYPO:0000023")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0000023> "Note that this term is not classified as a type of abnormal cell shape, small cells, have the same proportions as a subset of wild-type cells, and simply do not grow to the full length seen in wild type. Elongated cells, in contrast, have proportions (length:diameter ratio) that are never observed in wild-type cells, and so are classified under both abnormal cell shape and abnormal cell size.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000023> "small cell")
