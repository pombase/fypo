# Class: <http://purl.obolibrary.org/obo/FYPO_0005206> (abnormal mitotic cell cycle regulation upon nitrogen source shift)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21965528") Annotation(oboInOwl:hasDbXref "PMID:689088") Annotation(oboInOwl:hasDbXref "PMID:872891") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005206> "A cellular response phenotype observed in the vegetative growth phase of the life cycle in which the regulation of the mitotic cell cycle when cells are shifted from one nitrogen source to another. Normally, cell division is delayed upon shifting from a poor to a rich nitrogen source, and accelerated upon shifting from a rich to a poor nitrogen source.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005206> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005206> "2016-01-19T13:39:34Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005206> "abnormal cell cycle regulation upon nitrogen source shift")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005206> "abnormal cell cycle regulation upon nitrogen source shift during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005206> "abnormal mitotic cell cycle regulation during cellular response to nitrogen source shift")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005206> "abnormal mitotic cell cycle regulation upon nitrogen source shift during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005206> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005206> "FYPO:0005206")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005206> "Good (or rich) nitrogen sources are distinguished from poor sources based on how readily nitrogen is assimilated into cellular metabolism. In microorganisms, good nitrogen sources generally support higher cell population growth rates than poor sources. In fission yeast, cells divide at a smaller size when grown on a poor nitrogen source than in nitrogen-rich media; proline is commonly used as a poor nitrogen source.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005206> "abnormal mitotic cell cycle regulation upon nitrogen source shift")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005206> <http://purl.obolibrary.org/obo/FYPO_0000148>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0005207> (normal mitotic cell cycle regulation upon nitrogen source shift)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21965528") Annotation(oboInOwl:hasDbXref "PMID:689088") Annotation(oboInOwl:hasDbXref "PMID:872891") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005207> "A cellular response phenotype observed in the vegetative growth phase of the life cycle in which the regulation of the mitotic cell cycle is normal (i.e. indistinguishable from wild type) when cells are shifted from one nitrogen source to another. Normally, cell division is delayed upon shifting from a poor to a rich nitrogen source, and accelerated upon shifting from a rich to a poor nitrogen source.")
