AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004990> "2015-10-21T15:09:51Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0140013") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004990> "G2-exit meiotic nuclear division with abolished premeiotic DNA replication")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004990> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004990> "FYPO:0004990")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004990> "G2-exit meiosis with abolished premeiotic DNA replication")
