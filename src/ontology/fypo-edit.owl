# Class: <http://purl.obolibrary.org/obo/FYPO_0006850> (abnormal cell cycle arrest at mitotic G2/M phase transition following single cell division during nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:9472077") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0006850> "A cellular process phenotype in which progression through the mitotic cell cycle is arrested at the mitotic G2/M phase transition, instead of the normal G1 phase, and after the cell undergoes one cell division instead of the normal two, when the cell is subject to nitrogen starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0006850> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0006850> "2019-04-03T14:29:21Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "abnormal cell cycle arrest at mitotic G2/M phase transition following single cell division during nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "abnormal cell cycle arrest at mitotic G2/M phase transition following single cell division during nitrogen deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "abnormal mitotic cell cycle arrest at mitotic G2/M phase transition following single cell division during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "cell cycle arrest at mitotic G2/M phase transition following single cell division during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "mitotic G2 phase arrest following single cell division during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "one cell division prior to cell cycle arrest at mitotic G2/M phase transition during nitrogen starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0006850> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "abnormal cell cycle arrest in mitotic G2 phase following single cell division during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0006850> "abolished mitotic G2/M phase transition following single cell division during nitrogen starvation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0006850> "FYPO:0006850")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0006850> "This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. This term differs from 'abnormal cell cycle arrest at mitotic G2/M phase transition during nitrogen starvation' (FYPO:0001001) because it additionally specifies a single cell division, and from 'single cell division prior to G0 entry' (FYPO:0003877) because it does not apply only to G0, and does specify arrest in G2.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0006850> "abnormal cell cycle arrest at mitotic G2/M phase transition following single cell division during nitrogen starvation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0006850> <http://purl.obolibrary.org/obo/FYPO_0001001>)

