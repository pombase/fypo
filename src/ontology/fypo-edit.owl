AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004263> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004263> "FYPO:0004263")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004263> "Use this term if you have assayed growth of cells exposed to nitrogen limitation in culture. Note that nitrogen limitation differs from nitrogen starvation in that starvation results from complete absence of nitrogen, whereas limitation results from a shift from high to low nitrogen levels.")
