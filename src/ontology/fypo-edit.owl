AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0034080") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004322> "decreased spatial extent of centromere-specific nucleosome assembly")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0034080") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004322> "decreased spatial extent of centromeric DNA replication-independent nucleosome assembly")
