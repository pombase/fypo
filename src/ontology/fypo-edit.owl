# Class: <http://purl.obolibrary.org/obo/FYPO_0003990> (sensitive to DNA damage during mitotic S phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15643072") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003990> "A cell phenotype observed in the vegetative growth phase of the life cycle in which cells show increased sensitivity to DNA damage during S phase of the mitotic cell cycle.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003990> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003990> "2014-11-05T14:33:34Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003990> "decreased growth during cellular response to DNA damage during mitotic S phase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003990> "decreased vegetative cell population growth during cellular response to DNA damage during mitotic S phase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003990> "hypersensitive to DNA damage during mitotic S phase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003990> "sensitive to DNA damage during mitotic S phase during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003990> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003990> "sensitive to DNA damage during S phase of mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003990> "FYPO:0003990")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003990> "Use this term if you have assayed growth of cells exposed to DNA damage in culture. If you have assayed the response to DNA damage at the subcellular or molecular level, consider annotating to 'abnormal cellular response to DNA damage stimulus' (FYPO:0000157). Also consider specific phenotype terms for sensitivity to substances or other stimuli that can damage DNA, e.g. 'sensitive to DNA damaging agents' (FYPO:0000266), 'sensitive to methyl methanesulfonate' (FYPO:0000089), 'sensitive to UV' (FYPO:0000268), etc.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003990> "sensitive to DNA damage during mitotic S phase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003990> <http://purl.obolibrary.org/obo/FYPO_0000265>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0003991> (increased RNA level in stationary phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003991> "A cell phenotype in which the amount of RNA measured in a cell is higher than normal when the population in which the cell is found is in stationary phase. Total RNA or a specific RNA may be affected.")
