AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005429> "FYPO:0005429")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005429> "decreased UV-damage excision repair during mitotic G2 phase")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0005429> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0002052> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0070914> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002092> <http://purl.obolibrary.org/obo/GO_0000085>))))))
