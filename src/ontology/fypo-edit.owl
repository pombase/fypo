AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002272> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002272> "FYPO:0002272")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002272> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002272> "obsolete inviable microcolony, abnormal cell morphology")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002272> "true"^^xsd:boolean)

