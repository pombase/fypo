AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0070914") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0005428> "delayed onset of removal of 6-4 photoproducts")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0070914") Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0005428> "delayed onset of removal of cyclobutane pyrimidine dimers")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005428> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005428> "delayed onset of UV-damage excision repair during mitotic cell cycle")
