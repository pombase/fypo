AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0030163") Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002796> "abnormal protein catabolic process during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0030163") Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002796> "abnormal protein catabolism during nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002796> "abnormal protein degradation during nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002796> "abnormal protein degradation during nitrogen deprivation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002796> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002796> "FYPO:0002796")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002796> "This term can be used for any circumstances in which cells are starved for nitrogen. Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation; this term is not restricted to G0. We recommend noting which protein(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002796> "abnormal protein degradation during nitrogen starvation")
