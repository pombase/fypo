# Class: <http://purl.obolibrary.org/obo/FYPO_0001893> (abnormal sporulation resulting in formation of azygotic ascus with more or fewer than four spores)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22558440") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001893> "A sporulation phenotype in which azygotic asci that contain more or fewer than four spores form following conjugation, diploid growth, and subsequent azygotic sporulation. Azygotic ascus formation occurs when meiosis takes place within a diploid cell rather than in a zygote produced by sporulation. Zygotes can resume vegetative growth and form colonies of diploid cells if returned to rich media before commitment to meiosis; under nitrogen starvation, diploid cells heterozygous for mating type will undergo azygotic meiosis. Azygotic asci have a characteristic linear morphology resembling that of a single vegetatively growing cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001893> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001893> "2013-01-30T15:54:57Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001893> "abnormal sporulation resulting in formation of azygotic asci with more or fewer than four spores")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001893> "sporulation defects, azygotic asci with more or fewer than four spores")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001893> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001893> "FYPO:0001893")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001893> "abnormal sporulation resulting in formation of azygotic ascus with more or fewer than four spores")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0001893> <http://purl.obolibrary.org/obo/FYPO_0001894>)

