# Class: <http://purl.obolibrary.org/obo/FYPO_0002164> (mislocalized, curved actomyosin contractile ring)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002164> "A cell phenotype observed in the vegetative growth phase of the life cycle in which a cell forms an actomyosin contractile ring in an abnormal location, and the ring has a curved, or C-shaped, profile. The normal location is at the midpoint of, and perpendicular to, the long axis of the cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002164> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002164> "2013-05-10T16:32:44Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "actomyosin contractile ring displaced from midpoint and curved")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "contractile ring displaced from cell centre and curved")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "mislocalised, curved actomyosin contractile ring")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "mislocalized, curved actomyosin contractile ring during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "mislocalized, curved cytokinetic contractile ring")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "mislocalized, curved mitotic contractile ring")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002164> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "actomyosin contractile ring displaced from midpoint and bent")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002164> "mislocalized, curved actomyosin contractile ring during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002164> "FYPO:0002164")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002164> "Note that the location of the contractile ring is determined by the location of the cell division site, so an abnormality in cell division site determination can be inferred from this phenotype.")
