# Class: <http://purl.obolibrary.org/obo/FYPO_0005334> (increased number of Holliday junctions)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0000400") Annotation(oboInOwl:hasDbXref "PMID:15367656") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005334> "A cell phenotype observed in the vegetative growth phase of the life cycle in which the Holliday junctions is greater than normal. A Holliday junction is a structure where two DNA double strands are held together by reciprocal exchange of two of the four strands, one strand each from the two original helices.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005334> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005334> "2016-03-15T15:49:17Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005334> "increased number of Holliday junctions during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22927644") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005334> "increased number of four-way junctions")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005334> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:pr") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005334> "increased amount of X-shaped DNA")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005334> "increased number of Holliday junctions during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005334> "FYPO:0005334")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005334> "This phenotype can be detected by measuring the amount of DNA that migrates as X-shaped in two-dimensional agarose gels.")
