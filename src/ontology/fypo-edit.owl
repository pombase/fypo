AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0000643> "FYPO:0000643")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0000643> "abnormal mitotic DNA integrity checkpoint")
