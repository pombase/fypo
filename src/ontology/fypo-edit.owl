# Class: <http://purl.obolibrary.org/obo/FYPO_0005385> (abnormal cell cycle arrest in meiotic metaphase I)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0005385> "A cellular process phenotype in which progression through the first meiotic nuclear division (part of the meiotic cell cycle) is arrested in metaphase under conditions where arrest does not normally occur.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0005385> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0005385> "2016-04-25T16:39:35Z")
AnnotationAssertion(oboInOwl:hasAlternativeId <http://purl.obolibrary.org/obo/FYPO_0005385> "FYPO:0006769")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005385> "abnormal cell cycle arrest in metaphase I")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005385> "abnormal cell cycle arrest in metaphase I during meiotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0007127") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005385> "abnormal cell cycle arrest in metaphase during first meiotic nuclear division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005385> "abnormal cell cycle arrest in metaphase of meiosis I")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "Pombase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005385> "abnormal meiotic cell cycle arrest in metaphase I")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0005385> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0005385> "abolished meiosis I metaphase/anaphase transition")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0005385> "FYPO:0005385")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0005385> "Metaphase is defined as the part of mitosis when chromosomes are aligned in the middle of the spindle. If no spindle is present, do not use this term, but consider 'abnormal cell cycle arrest in mitotic prophase' (FYPO:0003145). Also do not use this term if the spindle has elongated at all. If the spindle has elongated, or you cannot tell whether a spindle is present, or metaphase cannot be clearly detected, annotate to the more general term 'abnormal cell cycle arrest in mitotic M phase' (FYPO:0000608). In cells that arrest in metaphase, chromosome separation does not occur.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0005385> "abnormal cell cycle arrest in meiotic metaphase I")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0005385> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000297> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000002> <http://purl.obolibrary.org/obo/GO_0007132>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0051321>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0005385> <http://purl.obolibrary.org/obo/FYPO_0002817>)

