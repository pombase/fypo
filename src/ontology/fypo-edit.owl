AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002485> "decreased resolution of meiotic recombination intermediates with crossover formation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002485> "reduced intergenic meiotic recombination")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002485> "reduced resolution of meiotic recombination intermediates with crossover formation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002485> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22723423") Annotation(oboInOwl:hasDbXref "PomBase:al") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002485> "decreased occurrence of meiotic cross-overs")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002485> "FYPO:0002485")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002485> "decreased intergenic meiotic recombination")
