AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0001742> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0001742> "FYPO:0001742")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0001742> "In S. pombe, isochromosome formation is most commonly observed with chromosome 3.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0001742> "increased isochromosome formation")
