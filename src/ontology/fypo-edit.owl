AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005027> "inviable following spore germination, without cell division, swollen binucleate multiseptate cell with central constriction")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0005027> "inviable germinated spore, without cell division, swollen binucleate multiseptate cell with central constriction")
