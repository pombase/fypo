AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002644> "decreased protein serine phosphorylation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002644> "FYPO:0002644")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002644> "This term was made obsolete to implement a decision that protein modification terms should only include residue-specific information in cases where it is especially biologically significant, such as in histones or the RNA polymerase II CTD. In all other cases, phenotypic effects on specific modified residues should be captured in annotation extensions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002644> "obsolete decreased protein serine phosphorylation during vegetative growth")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002644> "true"^^xsd:boolean)

