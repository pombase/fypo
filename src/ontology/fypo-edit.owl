# Class: <http://purl.obolibrary.org/obo/FYPO_0007392> (increased loss of disomic chromosome 3)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22737087") Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007392> "A cell phenotype in which that are aneuploid due to the presence of an extra copy of chromosome 3 lose the extra chromosome, producing haploid daughter cells, at a higher frequency than in otherwise wild-type cells.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007392> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007392> "2020-06-15T13:21:50Z"^^xsd:dateTime)
