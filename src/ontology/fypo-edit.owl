AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001864> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001864> "2012-12-18T15:35:33Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001864> "conjugation without glucose starvation")
