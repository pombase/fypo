# Class: <http://purl.obolibrary.org/obo/FYPO_0002466> (obsolete inviable mixed population including spores, germinated spores and cells with abnormal morphology)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002466> "OBSOLETE. A mixed population phenotype in which all cells in a population are inviable, and the population includes a mixture of ungerminated spores, germinated spores and cells with abnormal morphology (i.e. size, shape, or structure). The cells with normal morphology arise from division of some of the germinated spores, and may form a microcolony of up to 64 cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002466> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002466> "2013-08-06T16:17:57Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002466> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002466> "FYPO:0002466")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002466> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002466> "obsolete inviable mixed population including spores, germinated spores and cells with abnormal morphology")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002466> "true"^^xsd:boolean)

