AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003438> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003438> "delayed mitotic G1 phase progression following nitrogen starvation-induced G1 phase arrest")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003438> "increased duration of nitrogen starvation-induced mitotic G1 phase arrest")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003438> "FYPO:0003438")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003438> "A G1/S delay may indicate that a checkpoint, such as the cell size checkpoint or the G1/S DNA damage checkpoint, is activated. Checkpoint activation can be tested using checkpoint kinase mutants.")
