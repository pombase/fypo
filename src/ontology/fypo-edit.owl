# Class: <http://purl.obolibrary.org/obo/FYPO_0003376> (resistance to nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:al") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003376> "A cell phenotype observed in the vegetative growth phase of the life cycle in which cells show decreased sensitivity to nitrogen starvation. Cells go on to grow and divide to a greater extent than wild type following nitrogen starvation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003376> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003376> "2014-06-02T13:56:34Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "increased cell population growth during cellular response to nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "increased growth during cellular response to nitrogen starvation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "resistance to nitrogen depletion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "resistance to nitrogen deprivation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "resistance to nitrogen starvation during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "resistant to nitrogen starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003376> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003376> "resistance to nitrogen starvation during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003376> "FYPO:0003376")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003376> "Note that cells may enter G0 (quiescence) when subjected to prolonged nitrogen starvation, but this term does not refer to such prolonged starvation. Use this term if you have assayed growth of cells exposed to nitrogen starvation in culture. If you have assayed the response to nitrogen starvation at the subcellular or molecular level, consider annotating to 'abnormal cellular response to nitrogen starvation' (FYPO:0000152).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003376> "resistance to nitrogen starvation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003376> <http://purl.obolibrary.org/obo/FYPO_0000850>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0003377> (decreased RNA level during cellular response to nitrosative stress)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0071500") Annotation(oboInOwl:hasDbXref "PMID:20204527") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003377> "A cell phenotype observed in the vegetative growth phase of the life cycle in which the amount of RNA measured in a cell during a cellular response to nitrosative stress is lower than normal. Total RNA or a specific RNA may be affected. Nitrosative stress often results from exposure to high levels of nitric oxide (NO) or the highly reactive oxidant peroxynitrite, which is produced following interaction of NO with superoxide anions.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003377> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003377> "2014-06-02T14:05:02Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003377> "decreased RNA level during cellular response to nitrosative stress during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003377> "decreased transcript level during cellular response to nitrosative stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003377> "reduced RNA level during cellular response to nitrosative stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0003377> "decreased mRNA level during cellular response to nitrosative stress")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003377> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003377> "decreased RNA accumulation during cellular response to nitrosative stress")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003377> "decreased RNA level during cellular response to nitrosative stress during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003377> "FYPO:0003377")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003377> "Consider annotating to a term describing abnormal transcription or abnormal regulation of transcription, but note that changes in RNA levels may result from changes in RNA stability as well as changes in transcription. NO levels can be increased experimentally by adding sodium nitroprusside to growth media. We recommend noting which RNA(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003377> "decreased RNA level during cellular response to nitrosative stress")
