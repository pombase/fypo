# Class: <http://purl.obolibrary.org/obo/FYPO_0003830> (abnormal cytokinesis checkpoint)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0044878") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003830> "A cell cycle checkpoint phenotype in which the cytokinesis checkpoint of a mitotic cell cycle is abnormal. The cytokinesis checkpoint normally delays the G2/M transition of a mitotic cell cycle if cytokinesis was not completed correctly in the previous cell cycle. In a mutant, the checkpoint may fail to arrest or delay cell cycle progression under appropriate conditions, or the incidence or duration of arrest or delay may differ from wild type under any specified set of conditions.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003830> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003830> "2014-10-15T10:05:28Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0044878") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003830> "abnormal cytokinesis after mitosis checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003830> "abnormal mitotic cell cycle cytokinesis checkpoint")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003830> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003830> "abnormal cytokinesis checkpoint activation")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003830> "FYPO:0003830")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003830> "abnormal cytokinesis checkpoint")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0003830> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0044878>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003830> <http://purl.obolibrary.org/obo/FYPO_0001704>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0003831> (abolished response to cytokinesis checkpoint signaling)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0044878") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003831> "A cellular process phenotype in which a mitotic cell cycle arrest that normally occurs in response to the cytokinesis after mitosis checkpoint does not occur. The cytokinesis after mitosis checkpoint normally delays the G2/M transition of a mitotic cell cycle if cytokinesis was not completed correctly in the previous cell cycle. Abolished arrest may result from a problem with detection of conditions that normally trigger a checkpoint, transduction of the checkpoint signal, or the response to the checkpoint signal.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003831> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003831> "2014-10-15T10:24:37Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003831> "abolished response to cytokinesis after mitosis checkpoint signaling")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003831> "abolished response to mitotic cell cycle cytokinesis checkpoint signaling")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003831> "cell cycle arrest resulting from cytokinesis checkpoint activation abolished")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003831> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003831> "abolished cytokinesis after mitosis checkpoint")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003831> "abolished cytokinesis checkpoint activation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003831> "abolished cytokinesis checkpoint arrest")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003831> "FYPO:0003831")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003831> "May indicate that a cell cycle checkpoint is not activated under conditions that normally trigger checkpoint signaling and subsequent cell cycle arrest.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003831> "abolished response to cytokinesis checkpoint signaling")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003831> <http://purl.obolibrary.org/obo/FYPO_0003830>)

