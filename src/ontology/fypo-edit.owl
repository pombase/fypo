# Class: <http://purl.obolibrary.org/obo/FYPO_0004723> (transiently misoriented mitotic spindle)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15772152") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004723> "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the mitotic spindle is assembled in an incorrect orientation. Spindle orientation is later corrected so that the spindle is parallel to the long axis of the cell.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004723> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004723> "2015-07-27T12:29:27Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004723> "transient abnormal mitotic spindle orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004723> "transient mitotic spindle misorientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004723> "transiently misoriented mitotic spindle during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004723> "transiently misoriented spindle during mitotic cell cycle")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004723> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004723> "FYPO:0004723")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004723> "In wild-type cells, the spindle is initially misoriented in a small number of cells (typically around 8% of a cell population). Use this term if the frequency of spindle misorientation is increased above the wild-type occurrence.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004723> "transiently misoriented mitotic spindle")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004723> <http://purl.obolibrary.org/obo/FYPO_0007388>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004724> (long nuclear microtubules protruding through nuclear envelope during interphase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15772152") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004724> "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which cells form nuclear microtubules during interphase of the mitotic cell cycle that are longer than normal, and are partially or completely surrounded by an extension of the nuclear envelope. These microtubules usually have one end in close proximity to a spindle pole body, and may puncture the nuclear envelope to extent into the cytoplasm.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004724> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004724> "2015-07-27T12:51:58Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules during interphase, with nuclear envelope protrusion")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules protruding through nuclear envelope at interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules protruding through nuclear envelope during interphase during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules protruding through nuclear envelope during mitotic interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "nuclear envelope protrusion with long mitotic spindle microtubules protruding beyond SPB during interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "nuclear envelope protrusion with long mitotic spindle microtubules protruding beyond SPB during interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "nuclear envelope protrusion with long mitotic spindle microtubules protruding beyond spindle pole body during interphase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004724> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules during interphase, with nuclear envelope deformation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules protruding through nuclear envelope during interphase during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004724> "FYPO:0004724")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004724> "long nuclear microtubules protruding through nuclear envelope during interphase")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004724> <http://purl.obolibrary.org/obo/FYPO_0000055>)
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004724> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/FYPO_0004725>))

# Class: <http://purl.obolibrary.org/obo/FYPO_0004725> (nuclear envelope protrusion present during mitotic interphase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15772152") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004725> "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the nuclear envelope has one or more extensions that protrude into the cytoplasm during interphase of the mitotic cell cycle.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004725> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004725> "2015-07-27T12:52:58Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004725> "nuclear envelope protrusion present during interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004725> "nuclear envelope protrusion present during interphase during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004725> "protruding nuclear envelope during mitotic interphase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004725> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Pombase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004725> "nuclear envelope deformation during mitotic interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004725> "nuclear envelope protrusion present during interphase during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004725> "FYPO:0004725")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004725> "This term differs from 'lobate nuclear envelope' (FYPO:0002005) in that a lobate envelope has a few deep fissures extending inward from the cytoplasm that appear to partially divide the nucleus into portions, whereas protrusions are smaller and extend outward from the bulk of the nucleus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004725> "nuclear envelope protrusion present during mitotic interphase")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0004725> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001598> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000032> <http://purl.obolibrary.org/obo/GO_0051329>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0005635>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004725> <http://purl.obolibrary.org/obo/FYPO_0000769>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004726> (normal mitotic spindle orientation correction)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15772152") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004726> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which mitotic spindle orientation correction is normal (i.e. indistinguishable from wild type). Spindle orientation correction is the process by which a spindle that has formed in, or moved into, an incorrect orientation is restored to the correct orientation (parallel to the long axis of the cell).")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004726> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0004726> "2015-07-27T13:11:51Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004726> "normal correction of mitotic spindle orientation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004726> "normal mitotic spindle orientation correction during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:1990598") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004726> "normal repair of mitotic mono-orientation defect")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0004726> "normal spindle orientation correction during mitosis")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0004726> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0004726> "normal spindle orientation correction during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0004726> "FYPO:0004726")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0004726> "The mitotic spindle may form in an incorrect orientation infrequently in wild-type cells, or at a higher frequency in some mutants. Use this term for mutants in which the process of correcting the orientation of a misoriented spindle is the same as wild type, even if the initial misorientation occurs more frequently than in wild type.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0004726> "normal mitotic spindle orientation correction")
EquivalentClasses(<http://purl.obolibrary.org/obo/FYPO_0004726> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/GOREL_0000001> <http://purl.obolibrary.org/obo/GO_0072690>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0140429>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000461>))))
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0004726> <http://purl.obolibrary.org/obo/FYPO_0001319>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0004727> (cytoplasmic microtubule formation from nuclear microtubules)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15772152") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0004727> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which cytoplasmic microtubules are formed from existing nuclear microtubules. Normally, cytoplasmic microtubules are nucleated from microtubule organizing centers in the cytoplasm.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0004727> "midori")
