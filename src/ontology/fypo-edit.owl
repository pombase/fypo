# Class: <http://purl.obolibrary.org/obo/FYPO_0002652> (excess intracellular endomembrane system present)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21899677") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002652> "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which cells contain more intracellular endomembrane system structures than normal. The endomembrane system includes the endoplasmic reticulum, Golgi bodies, vesicles, cell membrane and nuclear envelope; in this phenotype, excess plasma membrane does not accumulate, but increased amounts of one or more internal intracellular endomembrane system structures may be present.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002652> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002652> "2013-09-12T15:12:13Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002652> "accumulation of internal endomembrane system structures")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002652> "excess intracellular endomembrane system present during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002652> "intracellular endomembrane system structures present in greater numbers")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002652> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002652> "excess intracellular endomembrane system present during mitotic cell cycle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002652> "increased level of intracellular endomembrane system structures")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002652> "FYPO:0002652")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002652> "excess intracellular endomembrane system present")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0002652> <http://purl.obolibrary.org/obo/FYPO_0002404>)

