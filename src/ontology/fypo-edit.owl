# Class: <http://purl.obolibrary.org/obo/FYPO_0002416> (obsolete inviable microcolony, swollen cells, abnormal cell shape)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002416> "OBSOLETE. A cell population phenotype in which a cell undergoes one or a few rounds of cell division before cells die, resulting in the formation a colony that contains only a few inviable cells in which cell shape is altered and cell volume is larger than normal. Up to 6 rounds of cell division (generating 64 cells) may be observed, but 3 divisions or fewer is more typical.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002416> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002416> "2013-07-31T16:24:46Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002416> "inviable microcolony, vegetative cells with increased cell volume and abnormal cell shape")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002416> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002416> "inviable microcolonies swollen misshapen cells")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002416> "inviable microcolony, enlarged vegetative cells with abnormal cell shape")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002416> "inviable microcolony, large vegetative cells with abnormal cell shape")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002416> "inviable microcolony, vegetative cells with increased cell size and abnormal cell shape")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002416> "FYPO:0002416")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002416> "This term was made obsolete because it is redundant with annotating to the equivalent cell phenotype, with penetrance extensions where needed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002416> "obsolete inviable microcolony, swollen cells, abnormal cell shape")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002416> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/FYPO_0002417> (obsolete inviable mixed population including spores and germinated spores with elongated germ tubes)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002417> "OBSOLETE. A mixed population phenotype in which all cells in a population are inviable, and the population includes a mixture of ungerminated spores and germinated spores with elongated germ tubes. The elongated cells arise from division of some of the germinated spores, and may form a microcolony of up to 64 cells.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002417> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002417> "2013-07-31T16:27:14Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002417> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0002417> "FYPO:0002417")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0002417> "This term was made obsolete because a \"mixed population\" observation would be better represented as two or more separate phenotype annotations, each with penetrance specified.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0002417> "obsolete inviable mixed population including spores and germinated spores with elongated germ tubes")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FYPO_0002417> "true"^^xsd:boolean)

