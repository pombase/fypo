# Class: <http://purl.obolibrary.org/obo/FYPO_0003913> (decreased minichromosome loss during vegetative growth)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003913> "A cell phenotype in which minichromosomes are lost at a lower frequency than normal during the vegetative growth phase of the life cycle. Minichromosome loss occurs when one or both daughter cells do not inherit copies of a minichromosome from the mother cell, and may result from failure of minichromosome replication or segregation.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003913> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003913> "2014-10-22T14:55:34Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003913> "reduced minichromosome loss during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003913> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003913> "decreased minichromosome loss during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003913> "FYPO:0003913")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003913> "Note that in budding yeast, a plasmid loss phenotype is often called a minichromosome maintenance defect, because \"minichromosome\" is roughly synonymous with an autonomously replicated and segregated plasmid in that organism. In fission yeast, a minichromosome is a large portion of a chromosome, usually about half of chromosome 3, that replicates and segregates autonomously. For smaller autonomously replicating and segregating constructs, consider 'decreased plasmid loss' (FYPO:0001311).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003913> "decreased minichromosome loss during vegetative growth")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003913> <http://purl.obolibrary.org/obo/FYPO_0003755>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0003914> (increased protein level in stationary phase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003914> "A cell phenotype in which the amount of protein measured in a cell is higher than normal when the population in which the cell is found is in stationary phase. Total protein or a specific protein may be affected.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003914> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003914> "2014-10-22T15:05:22Z")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003914> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0003914> "increased protein accumulation in stationary phase")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003914> "FYPO:0003914")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003914> "Consider annotating to a term describing abnormal translation or abnormal regulation of translation, but note that changes in protein levels may result from changes in protein stability or degradation as well as changes in protein synthesis. We recommend noting which protein(s) were used in the assay when annotating to this term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003914> "increased protein level in stationary phase")
