AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0003548> "mitotic cell cycle G1/S phase transition abolished following nitrogen starvation-induced G1 phase arrest")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003548> "fission_yeast_phenotype")
