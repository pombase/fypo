# Class: <http://purl.obolibrary.org/obo/FYPO_0002425> (abnormal actin cable organization during mitosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0070648") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0002425> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which actin cable organization is abnormal during mitosis. The process normally results in the assembly, arrangement of constituent parts, or disassembly of an actin cable. Actin cables are parallel actin filament bundles nucleated by formin, and are the most common form of actin filament bundles found in yeasts.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0002425> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0002425> "2013-08-01T17:15:08Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002425> "abnormal actin cable organisation during mitotic interphase")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002425> "abnormal actin cable organization during mitotic interphase during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0140014") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002425> "abnormal actin cable organization during mitotic nuclear division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0070648") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0002425> "abnormal formin-nucleated actin cable organization during mitotic interphase")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0002425> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0002425> "abnormal actin cable organization during mitotic M phase")
