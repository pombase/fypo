# Class: <http://purl.obolibrary.org/obo/FYPO_0003577> (abolished plasma membrane to vacuole transport after nitrogen starvation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:22194353") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0003577> "A cellular process phenotype in which the transport of a substance from the plasma membrane to the vacuole does not occur when the cell is subject to, or recovering from, nitrogen starvation. Transport normally occurs in two stages, plasma membrane to endosome followed by endosome to vacuole transport.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0003577> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0003577> "2014-07-22T12:35:29Z")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasNarrowSynonym <http://purl.obolibrary.org/obo/FYPO_0003577> "abolished plasma membrane to vacuole protein transport after nitrogen starvation")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0003577> "fission_yeast_phenotype")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0003577> "FYPO:0003577")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FYPO_0003577> "This term can be used to annotate phenotypes in which a protein that normally appears at the plasma membrane transiently during nitrogen starvation is not subsequently transported to the vacuole. It can also be used for the movement of other substances (e.g. lipids or ions) to or from the vacuole. If it is used for a protein transport phenotype, we recommend noting which protein(s) were used in the assay.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0003577> "abolished plasma membrane to vacuole transport after nitrogen starvation")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0003577> <http://purl.obolibrary.org/obo/FYPO_0003578>)

