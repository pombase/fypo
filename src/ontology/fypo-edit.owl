AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0051523") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007241> "abolished cell growth mode switching, monopolar to bipolar in cell derived from growing end and premature cell growth mode switching, monopolar to bipolar in cell derived from non-growing end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007241> "abolished new end take-off in cell derived from growing end and premature new end take-off in cell derived from non-growing end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007241> "abolished switch from monopolar to bipolar cell growth in cell derived from growing end and premature switch from monopolar to bipolar cell growth in cell derived from non-growing end")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007241> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007241> "abolished NETO in cell derived from growing end and premature NETO in cell derived from non-growing end during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007241> "FYPO:0007241")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007241> "abolished NETO in cell derived from growing end and premature NETO in cell derived from non-growing end")
