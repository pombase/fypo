# Class: <http://purl.obolibrary.org/obo/FYPO_0007571> (abnormal cortical endoplasmic reticulum organization)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GO:0007029") Annotation(oboInOwl:hasDbXref "GO:0032541") Annotation(oboInOwl:hasDbXref "PMID:19571115") Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007571> "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which cortical endoplasmic reticulum (ER) organization is abnormal. Cortical ER organization results in the assembly, arrangement of constituent parts, or disassembly of the part of the endoplasmic reticulum that consists of highly dynamic tubules that are juxtaposed to the plasma membrane.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007571> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007571> "2021-01-06T14:22:27Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007571> "abnormal cortical ER organization")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007571> "abnormal cortical endoplasmic reticulum organisation")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007571> "abnormal cortical endoplasmic reticulum organization during vegetative growth")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007571> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007571> "abnormal cortical endoplasmic reticulum organization during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007571> "FYPO:0007571")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007571> "abnormal cortical endoplasmic reticulum organization")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007571> <http://purl.obolibrary.org/obo/FYPO_0000805>)

