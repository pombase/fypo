# Class: <http://purl.obolibrary.org/obo/FYPO_0007659> (variable cell size at division with subsequent division at normal size)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007659> "A cell population phenotype in which cells in a population do not divide at a uniform size, although each cell divides to form equal-size daughter cells, which then subsequently divide at a normal size. Within one population, some cells may be larger and others smaller than normal (i.e. compared to wild-type cells under the same conditions) upon the first division. Daughter cells that are larger than normal upon formation divide earlier, and smaller-formed daughter cells divide later, than cells formed at a normal size.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/FYPO_0007659> "midori")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/FYPO_0007659> "2021-03-02T13:48:07Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007659> "increased variability of cell size in a vegetative population, with subsequent division at normal size")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007659> "variable cell length at entry into mitosis followed by equal cell division")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007659> "variable cell size at division with normal cell size homeostasis")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007659> "variable cell size at division with subsequent division at normal size during vegetative growth")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0007659> "variable vegetative cell size at division with subsequent division at normal size")
AnnotationAssertion(oboInOwl:hasOBONamespace <http://purl.obolibrary.org/obo/FYPO_0007659> "fission_yeast_phenotype")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasRelatedSynonym <http://purl.obolibrary.org/obo/FYPO_0007659> "variable cell size at division with subsequent division at normal size during mitotic cell cycle")
AnnotationAssertion(oboInOwl:id <http://purl.obolibrary.org/obo/FYPO_0007659> "FYPO:0007659")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FYPO_0007659> "variable cell size at division with subsequent division at normal size")
SubClassOf(<http://purl.obolibrary.org/obo/FYPO_0007659> <http://purl.obolibrary.org/obo/FYPO_0007474>)

# Class: <http://purl.obolibrary.org/obo/FYPO_0007660> (variable cell size at division with subsequent division at abnormal size)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:jh") Annotation(oboInOwl:hasDbXref "PomBase:mah") Annotation(oboInOwl:hasDbXref "PomBase:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0007660> "A cell population phenotype in which cells in a population do not divide at a uniform size, although each cell divides to form equal-size daughter cells, which then subsequently divide at an abnormal size. Within one population, some cells may be larger and others smaller than normal (i.e. compared to wild-type cells under the same conditions) upon each division.")
