# Class: <http://purl.obolibrary.org/obo/FYPO_0001227> (protein mislocalized to cytoplasm during cellular response to hydrogen peroxide)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FYPO_0001227> "A cell phenotype observed in the vegetative growth phase of the life cycle in which a protein that is not normally found in the cytoplasm is observed there, during a cellular response to hydrogen peroxide.")
AnnotationAssertion(oboInOwl:created_by <http://purl.obolibrary.org/obo/FYPO_0001227> "midori")
AnnotationAssertion(oboInOwl:creation_date <http://purl.obolibrary.org/obo/FYPO_0001227> "2012-07-13T16:15:07Z")
