AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001994> "inviable swollen elongated mononucleate vegetative cell with mislocalized septum near new end and mislocalized nucleus")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:vw") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001994> "inviable swollen elongated mononucleate vegetative cell with misplaced septum near new end")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PomBase:mah") oboInOwl:hasExactSynonym <http://purl.obolibrary.org/obo/FYPO_0001994> "inviable swollen elongated mononucleate vegetative cell with single mislocalized septum near new end")
